        if autoFarmEnabled and SETTINGS.AutoFarmMethod == "SELECTED_NAME" then
            farmCurrentTarget = nil
            if mountState and mountState.AutoFarm then
                mountState.Model = nil
                mountState.NextSearchAt = 0
            end
        end
    end)
end

-- Every word you type must match the model name or its folder name,
-- e.g. "thief npcs" or "iron ores".
local function searchModels()
    clearDropdown()

    local tokens = {}
    for token in string.gmatch(string.lower(searchBox.Text), "%S+") do
        table.insert(tokens, token)
    end

    local matches = {}

    for _, group in ipairs(modelCache.Groups) do
        local matched = true

        for _, token in ipairs(tokens) do
            if not string.find(group.Lower, token, 1, true)
                and not string.find(group.FolderLower, token, 1, true) then
                matched = false
                break
            end
        end

        if matched then
            table.insert(matches, group)
        end
    end

    local shown = math.min(#matches, SETTINGS.MaxDropdownRows)

    if shown < #matches then
        countLabel.Text = "LIVE DETECTION ON | " .. #matches .. " GROUPS / SHOWING " .. shown
    else
        countLabel.Text = "LIVE DETECTION ON | FOUND " .. #matches .. " GROUPS"
    end

    if #matches == 0 then
        create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 29),
            BackgroundTransparency = 1,
            Text = "NO MODELS FOUND",
            TextColor3 = COLORS.White,
            TextSize = 9,
            Font = Enum.Font.Gotham,
            ZIndex = 21,
        }, dropdownList)
    else
        for index = 1, shown do
            createDropdownRow(matches[index], index)
        end
    end

    updateSelectedStatus()
end

------------------------------------------------------------------------
-- LIVE WORKSPACE SPAWN DETECTION
------------------------------------------------------------------------

-- The periodic scan remains as a fallback, but newly-added Models, Parts, and
-- Folders invalidate only their direct Workspace root and trigger a quick
-- cache refresh. This catches fresh mobs and other models without repeatedly
-- rescanning every Workspace container.
local pendingWorkspaceRoots = {}
local workspaceRefreshQueued = false
local WORKSPACE_SPAWN_SCAN_DEBOUNCE = 0.18

local function getDirectWorkspaceRoot(instance)
    if not instance or instance == workspace then
        return nil
    end

    local root = instance
    while root and root.Parent and root.Parent ~= workspace do
        root = root.Parent
    end

    if root and root.Parent == workspace then
        return root
    end

    return nil
end

local function refreshAfterWorkspaceChange()
    if destroyed or not gui.Parent then
        return
    end

    updateWorkspaceStatus()
    updateSelectedStatus()

    if modelCache.Signature ~= lastSignature then
        lastSignature = modelCache.Signature
        searchModels()
    else
        updateDropdownCounts()
    end
end

local function scheduleWorkspaceRefresh()
    if workspaceRefreshQueued or destroyed then
        return
    end

    workspaceRefreshQueued = true

    task.delay(WORKSPACE_SPAWN_SCAN_DEBOUNCE, function()
        task.spawn(function()
            -- Do not invalidate a root while another cache build is reading it.
            while scanBusy and gui.Parent and not destroyed do
                task.wait(0.03)
            end

            if destroyed or not gui.Parent then
                workspaceRefreshQueued = false
                table.clear(pendingWorkspaceRoots)
                return
            end

            for root in pairs(pendingWorkspaceRoots) do
                rootEntries[root] = nil
            end
            table.clear(pendingWorkspaceRoots)

            -- Allow new events during this scan to queue another pass.
            workspaceRefreshQueued = false
            refreshModelCache(false)
            refreshAfterWorkspaceChange()

            if next(pendingWorkspaceRoots) ~= nil then
                scheduleWorkspaceRefresh()
            end
        end)
    end)
end

local function queueWorkspaceRootRefresh(instance)
    -- Highlights, attachments, scripts, and other non-target descendants do
    -- not need a full root rescan. Models, Parts, and Folders can change the
    -- selectable / farmable model index.
    if not instance:IsA("Model")
        and not instance:IsA("BasePart")
        and not instance:IsA("Folder")
        and not instance:IsA("ProximityPrompt") then
        return
    end

    local root = getDirectWorkspaceRoot(instance)
    if not root then
        return
    end

    pendingWorkspaceRoots[root] = true
    scheduleWorkspaceRefresh()
end

connectGlobal(workspace.DescendantAdded, queueWorkspaceRootRefresh)
connectGlobal(workspace.DescendantRemoving, queueWorkspaceRootRefresh)

