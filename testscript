local function hasPathSegment(path, wanted)
    wanted = string.lower(wanted)

    for segment in string.gmatch(path, "[^/]+") do
        if string.lower(segment) == wanted then
            return true
        end
    end

    return false
end

local function hasCollectionTag(object, tagName)
    if not object then
        return false
    end

    local ok, tagged = pcall(function()
        return CollectionService:HasTag(object, tagName)
    end)

    return ok and tagged
end

local function isNPCPath(path, object, rootFolder)
    if string.lower(rootFolder or "") == "npcs" then
        return true
    end

    if hasPathSegment(path, "NPC")
        or hasPathSegment(path, "NPCs")
        or hasPathSegment(path, "NonPlayerCharacters") then
        return true
    end

    if object and object:IsA("Model") then
        if object:GetAttribute("IsNPC") == true then
            return true
        end

        if hasCollectionTag(object, "NPC")
            or hasCollectionTag(object, "NPCs") then
            return true
        end
    end

    return false
end

local function isMobPath(path, object, rootFolder)
    if isNPCPath(path, object, rootFolder) then
        return false
    end

    if object and object:IsA("Model") then
        if object:GetAttribute("IsMob") == true then
            return true
        end

        if hasCollectionTag(object, "Mob")
            or hasCollectionTag(object, "Mobs") then
            return true
        end
    end

    if string.lower(rootFolder or "") == "mobs" then
        return true
    end

    if object and object:IsA("Model") then
        return object:FindFirstChildWhichIsA("Humanoid", true) ~= nil
    end

    return false
end

local function getEntryKind(path, object, rootFolder)
    if isNPCPath(path, object, rootFolder) then
        return "NPC"
    end

    if isMobPath(path, object, rootFolder) then
        return "Mob"
    end

    return "Object"
end

local function hasBasePart(model)
    if model:IsA("BasePart") then
        return true
    end

    return model:FindFirstChildWhichIsA("BasePart", true) ~= nil
end

local function addEntry(entries, folderCounts, object, path, rootFolder)
    if not (object:IsA("Model") or object:IsA("BasePart")) then
        return
    end

    if object:IsA("Model") and not hasBasePart(object) then
        return
    end

    local kind = getEntryKind(path, object, rootFolder)

    table.insert(entries, {
        Object = object,
        Name = object.Name,
        Path = path,
        RootFolder = rootFolder,
        Kind = kind,
        IsModel = object:IsA("Model"),
    })

    folderCounts[path] = (folderCounts[path] or 0) + 1
end

local function scanContainer(container, path, rootFolder, entries, folderPaths, folderCounts)
    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("Folder") then
            local childPath = path == "" and child.Name or path .. "/" .. child.Name
            folderPaths[childPath] = true
            scanContainer(child, childPath, rootFolder, entries, folderPaths, folderCounts)
        elseif child:IsA("Model") then
            addEntry(entries, folderCounts, child, path, rootFolder)
            scanContainer(child, path, rootFolder, entries, folderPaths, folderCounts)
        elseif child:IsA("BasePart") then
            if not child:FindFirstAncestorOfClass("Model") then
                addEntry(entries, folderCounts, child, path, rootFolder)
            end
        end
    end
end

local function refreshModelCache()
    local entries = {}
    local folderPathSet = {}
    local folderCounts = {}

    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Folder") then
            folderPathSet[child.Name] = true
            scanContainer(child, child.Name, child.Name, entries, folderPathSet, folderCounts)
        end
    end

    local groups = {}
    local byId = {}

    for _, entry in ipairs(entries) do
        local key = entry.Kind .. "|" .. entry.Name

        local group = groups[key]

        if not group then
            group = {
                Id = key,
                Name = entry.Name,
                Kind = entry.Kind,
                Entries = {},
                FolderPaths = {},
            }
            groups[key] = group
            byId[key] = group
        end

        table.insert(group.Entries, entry)
        group.FolderPaths[entry.Path] = true
    end

    local orderedGroups = {}

    for _, group in pairs(groups) do
        table.insert(orderedGroups, group)
    end

    table.sort(orderedGroups, function(a, b)
        if a.Kind == b.Kind then
            return a.Name:lower() < b.Name:lower()
        end
        return a.Kind < b.Kind
    end)

    local folderPaths = {}

    for path in pairs(folderPathSet) do
        table.insert(folderPaths, path)
    end

    table.sort(folderPaths, function(a, b)
        return a:lower() < b:lower()
    end)

    modelCache = {
        Entries = entries,
        Groups = orderedGroups,
        GroupsById = byId,
        FolderPaths = folderPaths,
        FolderCounts = folderCounts,
    }
end

local function getFolder(name)
    local folder = workspace:FindFirstChild(name)
    if folder and folder:IsA("Folder") then
        return folder
    end
    return nil
end

local function isInSelectedScope(entry)
    if selectedFolderPath == "ALL WORKSPACE" then
        return true
    end

    return entry.Path == selectedFolderPath
        or string.sub(entry.Path, 1, #selectedFolderPath + 1) == selectedFolderPath .. "/"
end

local function isEntryAlive(entry)
    local object = entry.Object

    if not object or not object.Parent then
        return false
    end

    if entry.IsModel then
        local humanoid = object:FindFirstChildWhichIsA("Humanoid", true)
        if humanoid and humanoid.Health <= 0 then
            return false
        end

        return getTeleportPart(object) ~= nil
    end

    return object:IsA("BasePart") and object:IsDescendantOf(workspace)
end

local function getEntryPosition(entry)
    local object = entry.Object

    if not object or not object.Parent then
        return Vector3.zero
    end

    if object:IsA("Model") then
        return object:GetPivot().Position
    end

    return object.Position
end

local function getGroupEntries(groupId)
    local group = modelCache.GroupsById[groupId]
    local result = {}

    if not group then
        return result
    end

    for _, entry in ipairs(group.Entries) do
        if isInSelectedScope(entry) and isEntryAlive(entry) then
            table.insert(result, entry)
        end
    end

    return result
end

local function countGroup(group)
    local count = 0

    for _, entry in ipairs(group.Entries) do
        if isInSelectedScope(entry) and isEntryAlive(entry) then
            count += 1
        end
    end

    return count
end

local function findNearestEntry(groupId)
    local entries = getGroupEntries(groupId)
    if #entries == 0 then
        return nil
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local origin = root and root.Position or Vector3.zero

    local nearest = nil
    local nearestDistance = math.huge

    for _, entry in ipairs(entries) do
        local distance = (getEntryPosition(entry) - origin).Magnitude
        if distance < nearestDistance then
            nearestDistance = distance
            nearest = entry
        end
    end

    return nearest
end

local function resolveSelectedEntry(target)
    if not target then
        return nil
    end

    if target.CurrentEntry and isEntryAlive(target.CurrentEntry) then
        return target.CurrentEntry
    end

    target.CurrentEntry = nil

    if target.Kind == "Mob" and SETTINGS.AutoNextMob then
        target.CurrentEntry = findNearestEntry(target.GroupId)
    end

    return target.CurrentEntry
end

local function getObjectBounds(object)
    if object:IsA("Model") then
        return object:GetBoundingBox()
    end

    return object.CFrame, object.Size
end

local function getMobFacing(object)
    local facingPart

    if object:IsA("Model") then
        facingPart = object:FindFirstChild("HumanoidRootPart", true)
            or object:FindFirstChild("UpperTorso", true)
            or object:FindFirstChild("Torso", true)
            or object:FindFirstChild("Head", true)
            or object.PrimaryPart
    else
        facingPart = object
    end

    local forward = facingPart and facingPart.CFrame.LookVector or Vector3.new(0, 0, -1)
    forward = Vector3.new(forward.X, 0, forward.Z)

    if forward.Magnitude < 0.01 then
        return Vector3.new(0, 0, -1)
    end

    return forward.Unit
end

local function getMobTopCFrame(entry)
    local object = entry.Object

    if not isEntryAlive(entry) then
        return nil
    end

    local head = object:IsA("Model") and object:FindFirstChild("Head", true) or nil
    local position

    if head and head:IsA("BasePart") then
        position = head.Position + Vector3.new(
            0,
            head.Size.Y / 2 + SETTINGS.MobHeadClearance,
            0
        )
    else
        local success, boxCFrame, boxSize = pcall(function()
            return getObjectBounds(object)
        end)

        if not success then
            return nil
        end

        position = boxCFrame.Position + Vector3.new(
            0,
            boxSize.Y / 2 + SETTINGS.MobHeadClearance,
            0
        )
    end

    local forward = getMobFacing(object)

    return CFrame.lookAt(
        position,
        position + Vector3.yAxis,
        forward
    )
end

local function getGenericTopCFrame(entry)
    local success, boxCFrame, boxSize = pcall(function()
        return getObjectBounds(entry.Object)
    end)

    if not success then
        return nil
    end

    local position = boxCFrame.Position + Vector3.new(
        0,
        boxSize.Y / 2 + SETTINGS.MobHeadClearance,
        0
    )

    local targetPosition = boxCFrame.Position
    local direction = Vector3.new(
        targetPosition.X - position.X,
        0,
        targetPosition.Z - position.Z
    )

    if direction.Magnitude < 0.01 then
        direction = Vector3.new(0, 0, -1)
    else
        direction = direction.Unit
    end

    return CFrame.lookAt(position, position + direction)
end

local function clearESP()
