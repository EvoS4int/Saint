local function applyTravelSpeed()
    if teleporting then
        feedbackLabel.Text = "CANNOT CHANGE SPEED DURING TELEPORT"
        speedBox.Text = tostring(SETTINGS.TeleportSpeed)
        return
    end

    local value = tonumber(speedBox.Text)

    if not value
        or value ~= value
        or value == math.huge
        or value == -math.huge then

        speedBox.Text = tostring(SETTINGS.TeleportSpeed)
        feedbackLabel.Text = "INVALID SPEED"
        return
    end

    value = math.clamp(
        value,
        SETTINGS.MinTravelSpeed,
        SETTINGS.MaxTravelSpeed
    )

    SETTINGS.TeleportSpeed = value
    speedBox.Text = tostring(value)

    feedbackLabel.Text = "TRAVEL SPEED: "
        .. tostring(value)
        .. " STUDS/SEC"
end

