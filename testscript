local function searchModels()
    clearDropdown()

    local query = searchBox.Text:lower()
    local matches = {}

    for _, group in ipairs(modelCache.Groups) do
        local name = group.Name:lower()
        local folder = group.Folder:lower()

        if query == ""
            or string.find(name, query, 1, true)
            or string.find(folder, query, 1, true) then

            table.insert(matches, group)
        end
    end

    countLabel.Text = "FOUND " .. #matches .. " MOB GROUPS"

    if #matches == 0 then
        create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 29),
            BackgroundTransparency = 1,
            Text = "NO MODELS FOUND",
            TextColor3 = COLORS.White,
            TextSize = 9,
            Font = Enum.Font.Gotham,
            ZIndex = 21,
        }, dropdownList)
    else
        for index, group in ipairs(matches) do
            createDropdownRow(group, index)
        end
    end

    updateSelectedStatus()
end

