local function getGroupsForScope()
    local result = {}

    for _, group in ipairs(modelCache.Groups) do
        local filtered = {}

        for _, entry in ipairs(group.Entries) do
            if isInSelectedScope(entry) and isEntryAlive(entry) then
                table.insert(filtered, entry)
            end
        end

        if #filtered > 0 then
            table.insert(result, {
                Id = group.Id,
                Name = group.Name,
                Kind = group.Kind,
                Entries = filtered,
            })
        end
    end

    table.sort(result, function(a, b)
        if a.Kind == b.Kind then
            return a.Name:lower() < b.Name:lower()
        end
        return a.Kind < b.Kind
    end)

    return result
end

updateSelectedStatus = function()
    if not selectedTarget then
        selectedLabel.Text = "NONE"
        modelStatus.Text = "STATUS: NOT SELECTED"
        teleportButton.Active = false
        teleportButton.Text = "TELEPORT TO SELECTED TARGET"
        return
    end

    local entry = selectedTarget.CurrentEntry

    if not entry or not isEntryAlive(entry) then
        selectedTarget.CurrentEntry = nil

        if selectedTarget.Kind == "Mob" and SETTINGS.AutoNextMob then
            local group = modelCache.GroupsById[selectedTarget.GroupId]
            local nearest = nil
            local nearestDistance = math.huge

            if group then
                local character = player.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                local origin = root and root.Position or Vector3.zero

                for _, candidate in ipairs(group.Entries) do
                    if isInSelectedScope(candidate) and isEntryAlive(candidate) then
                        local distance = (getEntryPosition(candidate) - origin).Magnitude
                        if distance < nearestDistance then
                            nearestDistance = distance
                            nearest = candidate
                        end
                    end
                end
            end

            selectedTarget.CurrentEntry = nearest
            entry = nearest
        end
    end

    local count = 0
    local group = modelCache.GroupsById[selectedTarget.GroupId]
    if group then
        for _, candidate in ipairs(group.Entries) do
            if isInSelectedScope(candidate) and isEntryAlive(candidate) then
                count += 1
            end
        end
    end

    selectedLabel.Text = "[" .. selectedTarget.Kind .. "] " .. selectedTarget.Name .. " | " .. count .. " AVAILABLE"

    if mountState and mountState.Entry == entry then
        modelStatus.Text = "FOLLOWING SELECTED TARGET"
        teleportButton.Active = false
        teleportButton.Text = "FOLLOWING"
        return
    end

    if not entry then
        modelStatus.Text = "NO AVAILABLE TARGET"
        teleportButton.Active = false
        teleportButton.Text = "NO AVAILABLE TARGET"
        return
    end

    if teleporting then
        modelStatus.Text = "TELEPORTING TO " .. selectedTarget.Name
        teleportButton.Active = false
        teleportButton.Text = "MOVING..."
        return
    end

    if selectedTarget.Kind == "Mob" and not mobTeleportEnabled then
        modelStatus.Text = "MOB TELEPORT DISABLED"
        teleportButton.Active = false
        teleportButton.Text = "MOB TELEPORT OFF"
        return
    end

    modelStatus.Text = entry.Path
    teleportButton.Active = true
    teleportButton.Text = "TELEPORT TO SELECTED TARGET"
end

