updateSelectedStatus = function()
    if not selectedTarget then
        selectedLabel.Text = "NONE"
        modelStatus.Text = "STATUS: NOT SELECTED"
        teleportButton.Active = false
        teleportButton.Text = "TELEPORT TO MODEL"
        return
    end

    local target = selectedTarget
    local model = resolveSelectedModel(target)
    local count = countAvailable(target.Folder, target.Name)

    selectedLabel.Text = "[" .. target.Folder .. "] "
        .. target.Name
        .. " | "
        .. count
        .. " AVAILABLE"

    if not model then
        if target.Folder == "Mobs" then
            modelStatus.Text = "NO LIVING MOB FOUND"
        elseif target.Folder == "NPCs" then
            modelStatus.Text = "CURRENT NPC UNAVAILABLE"
        else
            modelStatus.Text = "NO LIVING TARGET FOUND"
        end
        teleportButton.Active = false
        teleportButton.Text = "NO AVAILABLE TARGET"
        return
    end

    if mountState and mountState.Model == model then
        modelStatus.Text = "LYING FACE-UP UNDER THE MOB"
        teleportButton.Active = false
        teleportButton.Text = "MOUNTED"
        return
    end

    if teleporting then
        modelStatus.Text = "TARGET: " .. model.Name .. " / MOVING"
        teleportButton.Active = false
        teleportButton.Text = "MOVING..."
        return
    end

    if target.Folder == "Mobs" and not mobTeleportEnabled then
        modelStatus.Text = "AVAILABLE / MOB TP OFF"
        teleportButton.Active = false
        teleportButton.Text = "MOB TELEPORT OFF"
        return
    end

    if target.Folder == "Mobs" then
        modelStatus.Text = "AUTO NEXT SAME-NAME MOB ENABLED"
    elseif target.Folder == "NPCs" then
        modelStatus.Text = "NPC TARGET AVAILABLE"
    else
        modelStatus.Text = "TARGET AVAILABLE / AUTO NEXT SAME-NAME"
    end

    teleportButton.Active = true
    teleportButton.Text = "TELEPORT TO SELECTED MODEL"
end

