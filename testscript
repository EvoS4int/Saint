    if not selectedTarget then
        feedbackLabel.Text = "SELECT A TARGET FIRST"
        return
    end
    smoothTeleport(selectedTarget)
end)

connectGlobal(player.CharacterAdded, function()
    if mountState then
        stopMount(false)
    end
end)

destroyButton.Activated:Connect(function()
    doCleanup()
    gui:Destroy()
end)

gui.Destroying:Connect(doCleanup)

local function autoClickLoop()
    while gui.Parent and not destroyed do
        if autoClickEnabled and not teleporting and not mountState then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local tool = character and character:FindFirstChildOfClass("Tool")

            if humanoid and humanoid.Health > 0 and tool and tool.Enabled then
                pcall(function()
                    if tool.Parent == character and tool.Enabled and autoClickEnabled then
                        tool:Activate()
                    end
                end)
            end
        end
        task.wait(SETTINGS.AutoClickInterval)
    end
end

task.spawn(function()
    while gui.Parent and not destroyed do
        refreshModelCache()
        refreshFolderDropdown()
        refreshFolderStatus()
        updateSelectedStatus()
        if modelDropdown.Visible then
            updateSearch()
        end
        task.wait(SETTINGS.CacheRefreshRate)
    end
end)

