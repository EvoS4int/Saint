local function hasModelAncestorBefore(model, rootFolder)
    local ancestor = model.Parent

    while ancestor and ancestor ~= rootFolder do
        if ancestor:IsA("Model") then
            return true
        end
        ancestor = ancestor.Parent
    end

    return false
end

local function getTopLevelModels(folderName)
    local results = {}
    local seen = {}

    local function addFromRoot(rootFolder, npcOnly)
        if not rootFolder then
            return
        end

        for _, object in ipairs(rootFolder:GetDescendants()) do
            if object:IsA("Model")
                and not hasModelAncestorBefore(object, rootFolder) then

                local classifiedNPC = isNPCModel(object)
                local include = npcOnly and classifiedNPC
                    or (not npcOnly and not classifiedNPC)

                if include and not seen[object] then
                    seen[object] = true
                    table.insert(results, object)
                end
            end
        end
    end

    if folderName == "Mobs" then
        local mobsFolder = workspace:FindFirstChild("Mobs")
        if mobsFolder and mobsFolder:IsA("Folder") then
            addFromRoot(mobsFolder, false)
        end
    elseif folderName == "NPCs" then
        local npcsFolder = getFolder("NPCs")
        local mobsFolder = workspace:FindFirstChild("Mobs")

        if npcsFolder then
            addFromRoot(npcsFolder, true)
        end

        if mobsFolder and mobsFolder:IsA("Folder") then
            addFromRoot(mobsFolder, true)
        end
    end

    return results
end

local function refreshModelCache()
    local newCache = {
        ModelsByFolder = {
            Mobs = {},
            NPCs = {},
        },
        ByName = {
            Mobs = {},
            NPCs = {},
        },
        Parts = {},
        Humanoids = {},
        Groups = {},
    }

    for _, folderName in ipairs({"Mobs", "NPCs"}) do
        local folder = getFolder(folderName)

        if folder then
            local models = getTopLevelModels(folderName)
            newCache.ModelsByFolder[folderName] = models

            for _, model in ipairs(models) do
                local part = getTeleportPart(model)
                local humanoid = getHumanoid(model)

                newCache.Parts[model] = part
                newCache.Humanoids[model] = humanoid

                local group = newCache.ByName[folderName][model.Name]
                if not group then
                    group = {}
                    newCache.ByName[folderName][model.Name] = group
                end
                table.insert(group, model)
            end

            for name in pairs(newCache.ByName[folderName]) do
                table.insert(newCache.Groups, {
                    Folder = folderName,
                    Name = name,
                })
            end
        end
    end

    table.sort(newCache.Groups, function(a, b)
        local nameA = a.Name:lower()
        local nameB = b.Name:lower()
        if nameA == nameB then
            return a.Folder < b.Folder
        end
        return nameA < nameB
    end)

    modelCache = newCache
end

local function isCachedModelUsable(model, folderName)
    if not model then
        return false
    end

    local mobsFolder = workspace:FindFirstChild("Mobs")
    local npcsFolder = getFolder("NPCs")
    local belongsToFolder = false

    if folderName == "Mobs" then
        belongsToFolder = mobsFolder ~= nil
            and mobsFolder:IsA("Folder")
            and model:IsDescendantOf(mobsFolder)
            and not isNPCModel(model)
    elseif folderName == "NPCs" then
        local insideNPCFolder = npcsFolder ~= nil
            and model:IsDescendantOf(npcsFolder)

        local markedInsideMobs = mobsFolder ~= nil
            and mobsFolder:IsA("Folder")
            and model:IsDescendantOf(mobsFolder)
            and isNPCModel(model)

        belongsToFolder = insideNPCFolder or markedInsideMobs
    end

    if not belongsToFolder then
        return false
    end

    local part = modelCache.Parts[model]
    if not part or not part:IsDescendantOf(model) then
        part = getTeleportPart(model)
        modelCache.Parts[model] = part
    end

    if not part then
        return false
    end

    local humanoid = modelCache.Humanoids[model]
    if not humanoid or not humanoid.Parent then
        humanoid = getHumanoid(model)
        modelCache.Humanoids[model] = humanoid
    end

    return isAlive(model, humanoid)
end

local function getGroupModels(folderName, modelName)
    local candidates = modelCache.ByName[folderName]
        and modelCache.ByName[folderName][modelName]

    if not candidates then
        return {}
    end

    local results = {}
    for _, model in ipairs(candidates) do
        if isCachedModelUsable(model, folderName) then
            table.insert(results, model)
        end
    end
    return results
end

local function countAvailable(folderName, modelName)
    return #getGroupModels(folderName, modelName)
end

local function getModelPosition(model)
    local part = modelCache.Parts[model]
    if part and part.Parent then
        return part.Position
    end

    part = getTeleportPart(model)
    if part then
        modelCache.Parts[model] = part
        return part.Position
    end

    return model:GetPivot().Position
end

local function findNearestLiveModel(folderName, modelName)
    local models = getGroupModels(folderName, modelName)
    if #models == 0 then
        return nil
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local origin = root and root.Position or Vector3.zero

    local closestModel = nil
    local closestDistance = math.huge

    for _, model in ipairs(models) do
        local distance = (getModelPosition(model) - origin).Magnitude
        if distance < closestDistance then
            closestDistance = distance
            closestModel = model
        end
    end

    return closestModel
end

local function resolveSelectedModel(target)
    if not target then
        return nil
    end

    local current = target.CurrentModel
    if current and isCachedModelUsable(current, target.Folder) then
        return current
    end

    target.CurrentModel = nil

    if target.Folder == "Mobs" and SETTINGS.AutoNextMob then
        target.CurrentModel = findNearestLiveModel("Mobs", target.Name)
    end

    return target.CurrentModel
end

local function getMobForward(model)
    local part = model:FindFirstChild("HumanoidRootPart", true)
        or model:FindFirstChild("UpperTorso", true)
        or model:FindFirstChild("Torso", true)
        or model:FindFirstChild("Head", true)
        or model.PrimaryPart

    if not part or not part:IsA("BasePart") then
        return Vector3.new(0, 0, -1)
    end

    local forward = part.CFrame.LookVector
    forward = Vector3.new(forward.X, 0, forward.Z)

    if forward.Magnitude < 0.01 then
        return Vector3.new(0, 0, -1)
    end

    return forward.Unit
end

local function getMobTopCFrame(model)
    if not model or not isCachedModelUsable(model, "Mobs") then
        return nil
    end

    local head = model:FindFirstChild("Head", true)
    local headPosition

    if head and head:IsA("BasePart") then
        headPosition = Vector3.new(
            head.Position.X,
            head.Position.Y + head.Size.Y / 2 + SETTINGS.MobHeadClearance,
            head.Position.Z
        )
    else
        local success, boxCFrame, boxSize = pcall(function()
            return model:GetBoundingBox()
        end)

        if not success then
            return nil
        end

        headPosition = Vector3.new(
            boxCFrame.Position.X,
            boxCFrame.Position.Y + boxSize.Y / 2 + SETTINGS.MobHeadClearance,
            boxCFrame.Position.Z
        )
    end

    local mobForward = getMobForward(model)

    return CFrame.lookAt(
        headPosition,
        headPosition + Vector3.new(0, 1, 0),
        mobForward
    )
end

local function clearESP()
    for model, highlight in pairs(espHighlights) do
        if highlight then
            highlight:Destroy()
        end
        espHighlights[model] = nil
    end
