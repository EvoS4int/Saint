local function getMobDestination(model)
    if not model or not isCachedModelUsable(model, "Mobs") then
        return nil, "MOB IS DEAD OR UNAVAILABLE"
    end

    local success, boundingCFrame, boundingSize = pcall(function()
        return model:GetBoundingBox()
    end)

    if not success then
        return nil, "CANNOT READ MOB BOUNDING BOX"
    end

    local bottomY = boundingCFrame.Position.Y
        - boundingSize.Y / 2

    local destinationPosition = Vector3.new(
        boundingCFrame.Position.X,
        bottomY - SETTINGS.MobBelowDistance,
        boundingCFrame.Position.Z
    )

    local direction = Vector3.new(0, 0, -1)

    return CFrame.lookAt(
        destinationPosition,
        destinationPosition + direction
    )
end

local function getNPCDestination()
    return SETTINGS.NPCWorldPivot
end

local function playSmoothTween(
    root,
    destination,
    duration,
    style,
    targetModel
)
    local tween = TweenService:Create(
        root,
        TweenInfo.new(
            duration,
            style or Enum.EasingStyle.Linear,
            Enum.EasingDirection.InOut
        ),
        {
            CFrame = destination
        }
    )

    activeTween = tween

    local completed = false
    local playbackState = nil

    local connection = tween.Completed:Connect(function(state)
        completed = true
        playbackState = state
    end)

    tween:Play()

    while not completed do
        task.wait(0.1)

        if targetModel
            and not isCachedModelUsable(targetModel, "Mobs") then

            tween:Cancel()
            break
        end

        if destroyed or not gui.Parent then
            tween:Cancel()
            break
        end
    end

    connection:Disconnect()

    if activeTween == tween then
        activeTween = nil
    end

    if playbackState ~= Enum.PlaybackState.Completed then
        error("TARGET REMOVED OR MOVEMENT INTERRUPTED")
    end
end

local function smoothTeleport(target)
    if teleporting or not target then
        return
    end

    local isNPC = target.Folder == "NPCs"
    local isMob = target.Folder == "Mobs"

    if isMob and not mobTeleportEnabled then
        feedbackLabel.Text = "MOB TELEPORT IS OFF"
        return
    end

    local model = resolveSelectedModel(target)

    if not model then
        feedbackLabel.Text = "NO LIVING TARGET FOUND"
        updateSelectedStatus()
        return
    end

    local character = player.Character

    if not character then
        feedbackLabel.Text = "CHARACTER NOT LOADED"
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then
        feedbackLabel.Text = "CHARACTER COMPONENTS MISSING"
        return
    end

    if humanoid.Health <= 0 then
        feedbackLabel.Text = "CHARACTER IS DEAD"
        return
    end

    local destination
    local errorMessage

    if isNPC then
        destination = getNPCDestination()
    else
        destination, errorMessage = getMobDestination(model)

        if not destination then
            feedbackLabel.Text = errorMessage
            return
        end
    end

    local startingPosition

    if isNPC then
        startingPosition = destination
            * CFrame.new(0, -SETTINGS.NPCBelowDistance, 0)
    else
        startingPosition = destination
    end

    local distance = (
        startingPosition.Position - root.Position
    ).Magnitude

    local travelDuration = math.clamp(
        distance / SETTINGS.TeleportSpeed,
        SETTINGS.MinDuration,
        SETTINGS.MaxDuration
    )

    teleporting = true
    updateSelectedStatus()

    local previousAnchored = root.Anchored
    local previousAutoRotate = humanoid.AutoRotate

    local look = root.CFrame.LookVector

    local flatLook = Vector3.new(look.X, 0, look.Z)

    if flatLook.Magnitude < 0.01 then
        flatLook = Vector3.new(0, 0, -1)
    else
        flatLook = flatLook.Unit
    end

    local uprightStart = CFrame.lookAt(
        root.Position,
        root.Position + flatLook
    )

    local laidStart = uprightStart * LAY_ROTATION
    local laidDestination = startingPosition * LAY_ROTATION

    local targetToMonitor = isMob and model or nil

    local success, err = pcall(function()
        humanoid.AutoRotate = false

        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero

        root.Anchored = true

        feedbackLabel.Text = "LYING DOWN..."

        playSmoothTween(
            root,
            laidStart,
            SETTINGS.LayDuration,
            Enum.EasingStyle.Sine
        )

        feedbackLabel.Text = isNPC
            and "APPROACHING NPC..."
            or "MOVING TO " .. target.Name

        playSmoothTween(
            root,
            laidDestination,
            travelDuration,
            Enum.EasingStyle.Linear,
            targetToMonitor
        )

        if isNPC then
            feedbackLabel.Text = "SLOWLY ASCENDING..."

            playSmoothTween(
                root,
                destination * LAY_ROTATION,
                SETTINGS.NPCRiseDuration,
                Enum.EasingStyle.Sine
            )
        end

        feedbackLabel.Text = "STANDING UP..."

        playSmoothTween(
            root,
            destination,
            SETTINGS.StandDuration,
            Enum.EasingStyle.Sine
        )
    end)

    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end

    if root.Parent then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero

        if not success then
            root.CFrame = CFrame.new(root.Position)
        end

        root.Anchored = previousAnchored
    end

    if humanoid.Parent then
        humanoid.AutoRotate = previousAutoRotate

        if humanoid.Health > 0 then
            humanoid:ChangeState(
                Enum.HumanoidStateType.GettingUp
            )
        end
    end

    teleporting = false

    updateSelectedStatus()

    if success then
        feedbackLabel.Text = isNPC
            and "ARRIVED AT NPC WORLD PIVOT"
            or "ARRIVED AT " .. target.Name
    elseif isMob and not isCachedModelUsable(model, "Mobs") then
        feedbackLabel.Text = "MOB DIED - NEXT TARGET SELECTED"
    else
        feedbackLabel.Text = "FAILED: " .. tostring(err)
    end
end

