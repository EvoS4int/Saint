local function playCharacterTween(character, destinationRoot, rootToPivot, duration, style, targetEntry)
    local driver = Instance.new("CFrameValue")
    driver.Value = character:GetPivot()
    activeDriver = driver

    local pivotConnection = driver:GetPropertyChangedSignal("Value"):Connect(function()
        if character.Parent then
            character:PivotTo(driver.Value)
        end
    end)

    local tween = TweenService:Create(
        driver,
        TweenInfo.new(
            duration,
            style or Enum.EasingStyle.Linear,
            Enum.EasingDirection.InOut
        ),
        {
            Value = destinationRoot * rootToPivot
        }
    )

    activeTween = tween
    local completed = false
    local playbackState

    local completionConnection = tween.Completed:Connect(function(state)
        completed = true
        playbackState = state
    end)

    tween:Play()

    while not completed do
        task.wait(0.05)

        if targetEntry and not isEntryAlive(targetEntry) then
            tween:Cancel()
            break
        end

        if destroyed or not gui.Parent or not character.Parent then
            tween:Cancel()
            break
        end
    end

    completionConnection:Disconnect()
    pivotConnection:Disconnect()

    if activeTween == tween then
        activeTween = nil
    end

    if activeDriver == driver then
        activeDriver = nil
    end

    driver:Destroy()

    if playbackState ~= Enum.PlaybackState.Completed then
        error("MOVEMENT INTERRUPTED OR TARGET REMOVED")
    end
end

local function smoothTeleport(target)
    if teleporting or not target then
        return
    end

    if target.Kind == "Mob" and not mobTeleportEnabled then
        feedbackLabel.Text = "MOB TELEPORT IS OFF"
        return
    end

    local entry = resolveSelectedEntry(target)

    if not entry then
        feedbackLabel.Text = "NO AVAILABLE TARGET"
        updateSelectedStatus()
        return
    end

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not character or not humanoid or not root or humanoid.Health <= 0 then
        feedbackLabel.Text = "CHARACTER NOT READY"
        return
    end

    if mountState then
        stopMount(true)
    end

    local destination = getEntryTeleportCFrame(entry, humanoid)

    if not destination then
        feedbackLabel.Text = "CANNOT FIND TARGET POSITION"
        return
    end

    local isNPC = entry.Kind == "NPC"
    local isMob = entry.Kind == "Mob"

    local startingPosition = destination

    if isNPC then
        startingPosition = destination
            * CFrame.new(0, -SETTINGS.NPCBelowDistance, 0)
    end

    local distance = (startingPosition.Position - root.Position).Magnitude
    local travelDuration = math.clamp(
        distance / SETTINGS.TeleportSpeed,
        SETTINGS.MinDuration,
        SETTINGS.MaxDuration
    )

    teleporting = true
    updateSelectedStatus()

    local saved = {
        Character = character,
        Humanoid = humanoid,
        Root = root,
        Anchored = root.Anchored,
        PlatformStand = humanoid.PlatformStand,
        AutoRotate = humanoid.AutoRotate,
        AnimateScript = character:FindFirstChild("Animate"),
        AnimationSpeeds = {},
        RootToPivot = root.CFrame:ToObjectSpace(character:GetPivot()),
    }

    activeSavedState = saved

    if saved.AnimateScript and saved.AnimateScript:IsA("BaseScript") then
        saved.AnimateDisabled = saved.AnimateScript.Disabled
        saved.AnimateScript.Disabled = true
    end

    for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
        local ok, speed = pcall(function()
            return track.Speed
        end)

        if ok then
            table.insert(saved.AnimationSpeeds, {Track = track, Speed = speed})
            pcall(function()
                track:AdjustSpeed(0)
            end)
        end
    end

    humanoid.AutoRotate = false
    humanoid.PlatformStand = true
    humanoid:ChangeState(Enum.HumanoidStateType.Physics)

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.Anchored = true

    local success, err = pcall(function()
        if isNPC then
            local npcLay = startingPosition * FACE_UP_ROTATION

            playCharacterTween(
                character,
                npcLay,
                saved.RootToPivot,
                travelDuration,
                Enum.EasingStyle.Linear
            )

            playCharacterTween(
                character,
                destination * FACE_UP_ROTATION,
                saved.RootToPivot,
                SETTINGS.NPCRiseDuration,
                Enum.EasingStyle.Sine
            )

            playCharacterTween(
                character,
                destination,
                saved.RootToPivot,
                SETTINGS.StandDuration,
                Enum.EasingStyle.Sine
            )
        elseif isMob then
            feedbackLabel.Text = "MOVING ABOVE MOB HEAD..."

            playCharacterTween(
                character,
                destination,
                saved.RootToPivot,
                travelDuration,
                Enum.EasingStyle.Sine,
                entry
            )

            if not isEntryAlive(entry) then
                error("MOB DIED DURING TELEPORT")
            end
        else
            feedbackLabel.Text = "MOVING TO SELECTED OBJECT..."

            playCharacterTween(
                character,
                destination,
                saved.RootToPivot,
                travelDuration,
                Enum.EasingStyle.Sine
            )

            playCharacterTween(
                character,
                destination,
                saved.RootToPivot,
                SETTINGS.StandDuration,
                Enum.EasingStyle.Sine
            )
        end
    end)

    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end

    if activeDriver then
        activeDriver:Destroy()
        activeDriver = nil
    end

    teleporting = false

    local shouldMount = success
        and isMob
        and backFollowEnabled
        and isEntryAlive(entry)

    if shouldMount then
        startMobMount(entry, saved)
    else
        restoreCharacterState(saved, not success or isMob)
    end

    updateSelectedStatus()

    if success then
        if isNPC then
            feedbackLabel.Text = "ARRIVED AT NPC WORLD PIVOT"
        elseif shouldMount then
            feedbackLabel.Text = "FACE-UP FOLLOWING MOB HEAD"
        else
            feedbackLabel.Text = "ARRIVED AT " .. entry.Name
        end
    elseif not isEntryAlive(entry) then
        feedbackLabel.Text = "TARGET REMOVED - SAME GROUP UPDATED"
    else
        feedbackLabel.Text = "TELEPORT FAILED: " .. tostring(err)
    end
end

local function updateMobToggle()
    mobToggleButton.Text = mobTeleportEnabled and "ON" or "OFF"
    toggleDescription.Text = mobTeleportEnabled
        and "AUTO NEXT SAME-NAME MOB: ON"
        or "MOB TELEPORT DISABLED"
end

local function updateESPToggle()
    espToggleButton.Text = espEnabled and "ON" or "OFF"
    espDescription.Text = espEnabled
        and "OUTLINE ONLY / OCCLUDED"
        or "MOB ESP DISABLED"
    if not espEnabled then
        clearESP()
    end
end

local function updateAutoClickToggle()
    autoClickButton.Text = autoClickEnabled and "ON" or "OFF"
    autoClickDescription.Text = autoClickEnabled
        and "TOOL ACTIVATE / NO MOUSE INPUT"
        or "AUTO CLICK DISABLED"
end

local function updateBackFollowToggle()
    backFollowButton.Text = backFollowEnabled and "ON" or "OFF"
    backFollowDescription.Text = backFollowEnabled
        and "FACE-UP / 5 STUDS ABOVE HEAD"
        or "HEAD FOLLOW DISABLED"
end

local function applyTravelSpeed()
    if teleporting then
        feedbackLabel.Text = "CANNOT CHANGE SPEED DURING TELEPORT"
        speedBox.Text = tostring(SETTINGS.TeleportSpeed)
        return
    end

    local value = tonumber(speedBox.Text)
    if not value or value ~= value or value == math.huge or value == -math.huge then
        speedBox.Text = tostring(SETTINGS.TeleportSpeed)
        feedbackLabel.Text = "INVALID SPEED"
        return
    end

    value = math.clamp(value, SETTINGS.MinTravelSpeed, SETTINGS.MaxTravelSpeed)
    SETTINGS.TeleportSpeed = value
    speedBox.Text = tostring(value)
    feedbackLabel.Text = "TRAVEL SPEED: " .. tostring(value) .. " STUDS/SEC"
end

updateSearch = function()
    clearScroll(modelDropdown, modelRows)

    local query = string.lower(searchBox.Text)
    local matches = {}

    for _, group in ipairs(getGroupsForScope()) do
        local pathSet = {}
        for _, entry in ipairs(group.Entries) do
            pathSet[entry.Path] = true
        end

        local pathNames = {}
        for path in pairs(pathSet) do
            table.insert(pathNames, path)
        end
        table.sort(pathNames)

        local pathText = string.lower(table.concat(pathNames, " "))
        local nameText = string.lower(group.Name)
        local kindText = string.lower(group.Kind)

        if query == ""
            or string.find(nameText, query, 1, true)
            or string.find(kindText, query, 1, true)
            or string.find(pathText, query, 1, true) then
            table.insert(matches, group)
        end
    end

    countLabel.Text = "FOUND " .. #matches .. " GROUPS"

    if #matches == 0 then
        local empty = makeLabel(
            modelDropdown,
            "NoResults",
            "NO TELEPORTABLE MODELS OR PARTS FOUND",
            UDim2.new(1, -4, 0, 27),
            UDim2.fromOffset(0, 0),
            8
        )
        empty.ZIndex = 26
        table.insert(modelRows, empty)
    else
        for index, group in ipairs(matches) do
            local option = create("TextButton", {
                Name = "TargetGroup",
                Size = UDim2.new(1, 0, 0, 28),
                BackgroundColor3 = COLORS.Element,
                BorderSizePixel = 0,
                Text = "[" .. group.Kind .. "] " .. group.Name .. " | " .. #group.Entries .. " FOUND",
                TextColor3 = COLORS.White,
                TextSize = 9,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left,
                LayoutOrder = index,
                ZIndex = 26,
            }, modelDropdown)

            addCorner(option, 5)
            addStroke(option, 0.6, 1)
            create("UIPadding", {PaddingLeft = UDim.new(0, 8)}, option)

            table.insert(modelRows, {Button = option, Group = group})

            option.Activated:Connect(function()
                if teleporting then
                    return
                end

                if mountState then
                    stopMount(true)
                end

                selectedTarget = {
                    GroupId = group.Id,
                    Kind = group.Kind,
                    Name = group.Name,
                    CurrentEntry = findNearestEntry(group.Id),
                }

                modelButton.Text = "[" .. group.Kind .. "] " .. group.Name .. "     v"
                modelDropdown.Visible = false
                updateSelectedStatus()
                feedbackLabel.Text = "SELECTED: " .. group.Name
            end)
        end
    end

    updateSelectedStatus()
end

local function refreshFolderDropdown()
    local signature = table.concat(modelCache.FolderPaths, "|")
    if signature == folderDropdownSignature then
        return
    end
    folderDropdownSignature = signature
    clearScroll(folderDropdown, folderRows)

    local function addOption(path, index)
        local button = create("TextButton", {
            Name = "FolderOption",
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundColor3 = COLORS.Element,
            BorderSizePixel = 0,
            Text = path,
            TextColor3 = COLORS.White,
            TextSize = 9,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = index,
            ZIndex = 31,
        }, folderDropdown)

        addCorner(button, 4)
        create("UIPadding", {PaddingLeft = UDim.new(0, 8)}, button)
        table.insert(folderRows, button)

        button.Activated:Connect(function()
            selectedFolderPath = path
            folderButton.Text = path .. "     v"
            folderDropdown.Visible = false
            selectedTarget = nil
            modelButton.Text = "SELECT A MODEL OR PART     v"
            updateSearch()
            feedbackLabel.Text = "FOLDER SELECTED: " .. path
        end)
    end

    addOption("ALL WORKSPACE", 1)

    for index, path in ipairs(modelCache.FolderPaths) do
        addOption(path, index + 1)
    end
end

local function refreshFolderStatus()
    clearScroll(folderStatusScroll, folderStatusRows)

    for index, path in ipairs(modelCache.FolderPaths) do
        local count = modelCache.FolderCounts[path] or 0
        local row = create("TextLabel", {
            Name = "FolderStatus_" .. index,
            Size = UDim2.new(1, -4, 0, 22),
            BackgroundColor3 = COLORS.Element,
            BorderSizePixel = 0,
            Text = path .. " | " .. count .. " TARGETS",
            TextColor3 = COLORS.White,
            TextSize = 9,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, folderStatusScroll)
        addCorner(row, 4)
        create("UIPadding", {PaddingLeft = UDim.new(0, 7)}, row)
        table.insert(folderStatusRows, row)
    end

    if #modelCache.FolderPaths == 0 then
        local empty = makeLabel(
            folderStatusScroll,
            "NoFolders",
            "NO WORKSPACE FOLDERS FOUND",
            UDim2.new(1, -4, 0, 22),
            UDim2.fromOffset(0, 0),
            9
        )
        table.insert(folderStatusRows, empty)
    end
end

local function doCleanup()
    if destroyed then
        return
    end

    destroyed = true
    dragging = false
    dragInput = nil

    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end

    if activeDriver then
        activeDriver:Destroy()
        activeDriver = nil
    end

    if mountState then
        stopMount(true)
    elseif activeSavedState then
        restoreCharacterState(activeSavedState, true)
    end

    clearESP()

    for _, connection in ipairs(globalConnections) do
        connection:Disconnect()
    end
    table.clear(globalConnections)
end

