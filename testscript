local function getMobTopCFrame(model)
    if not model or not isCachedModelUsable(model, "Mobs") then
        return nil
    end

    local head = model:FindFirstChild("Head", true)
    local headPosition

    if head and head:IsA("BasePart") then
        headPosition = Vector3.new(
            head.Position.X,
            head.Position.Y + head.Size.Y / 2 + SETTINGS.MobHeadClearance,
            head.Position.Z
        )
    else
        local success, boxCFrame, boxSize = pcall(function()
            return model:GetBoundingBox()
        end)

        if not success then
            return nil
        end

        headPosition = Vector3.new(
            boxCFrame.Position.X,
            boxCFrame.Position.Y + boxSize.Y / 2 + SETTINGS.MobHeadClearance,
            boxCFrame.Position.Z
        )
    end

    local facingPart = model:FindFirstChild("HumanoidRootPart", true)
        or model:FindFirstChild("UpperTorso", true)
        or model:FindFirstChild("Torso", true)
        or model:FindFirstChild("Head", true)
        or model.PrimaryPart

    local forward = Vector3.new(0, 0, -1)
    if facingPart and facingPart:IsA("BasePart") then
        local look = facingPart.CFrame.LookVector
        forward = Vector3.new(look.X, 0, look.Z)
        if forward.Magnitude < 0.01 then
            forward = Vector3.new(0, 0, -1)
        else
            forward = forward.Unit
