        or "NEARBY G CHEST PROMPTS ONLY"
end

local function startAutoChestWorker()
    autoChestToken = autoChestToken + 1
    local myToken = autoChestToken

    task.spawn(function()
        while not destroyed
            and gui.Parent
            and myToken == autoChestToken
            and (autoChestEnabled or autoGPromptEnabled) do

            if not teleporting then
                local maxDistance = autoChestEnabled and SETTINGS.AutoChestRadius or math.huge
                local prompt = findChestGPrompt(maxDistance, not autoChestEnabled)

                if prompt then
                    local character = player.Character
                    local root = character and character:FindFirstChild("HumanoidRootPart")
                    local promptPosition = getPromptWorldPosition(prompt)
                    local distance = root and promptPosition
                        and (root.Position - promptPosition).Magnitude
                        or math.huge

                    if autoChestEnabled and distance > math.max(1, prompt.MaxActivationDistance - 0.5) then
                        feedbackLabel.Text = "AUTO CHEST: APPROACHING " .. string.upper(prompt.ObjectText ~= "" and prompt.ObjectText or "CHEST")
                        moveCharacterNearChestPrompt(prompt)
                        task.wait(0.2)
                    end

                    if (autoChestEnabled or autoGPromptEnabled)
                        and prompt.Parent
                        and activateChestGPrompt(prompt) then
                        feedbackLabel.Text = "AUTO CHEST: G PROMPT ACTIVATED"
                    end
                elseif autoChestEnabled then
                    feedbackLabel.Text = "AUTO CHEST: SEARCHING FOR G-KEY CHESTS"
                end
            end

            task.wait(SETTINGS.AutoChestSearchInterval)
        end
    end)
end

local function setAutoChestEnabled(enabled)
    enabled = enabled == true
    if autoChestEnabled == enabled then
        return
    end

    if enabled then
        if teleporting then
            feedbackLabel.Text = "WAIT UNTIL TELEPORT FINISHES"
            return
        end

        -- AutoChest takes movement control from mob tracking / AutoFarm.
        if autoFarmEnabled then
            setAutoFarmEnabled(false)
        end
        teleportModeEnabled = false
        mobSearchToken = mobSearchToken + 1
        if mountState then
            stopMount()
        end

        local character = player.Character
        if not character or not character.Parent then
            feedbackLabel.Text = "CHARACTER NOT LOADED"
            return
        end
        if not lastReturnPivot then
            lastReturnPivot = character:GetPivot()
            returnButton.Active = true
        end
    end

    autoChestEnabled = enabled
    SETTINGS.AutoChestEnabled = autoChestEnabled
    updateAutoChestToggle()

    autoChestToken = autoChestToken + 1
    if autoChestEnabled or autoGPromptEnabled then
        startAutoChestWorker()
    else
        feedbackLabel.Text = "AUTO CHEST DISABLED"
    end
end

local function setAutoGPromptEnabled(enabled)
    autoGPromptEnabled = enabled == true
    SETTINGS.AutoGPromptEnabled = autoGPromptEnabled
    updateAutoGPromptToggle()

    autoChestToken = autoChestToken + 1
    if autoChestEnabled or autoGPromptEnabled then
        startAutoChestWorker()
    else
        feedbackLabel.Text = "AUTO G PROMPT DISABLED"
    end
end

