local function createESP(object)
    if espHighlights[object] then
        return espHighlights[object]
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "LocalMobESP"
    highlight.Adornee = object
    highlight.FillTransparency = 1
    highlight.OutlineColor = COLORS.White
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Parent = object

    espHighlights[object] = highlight
    return highlight
end

local function updateESP()
    if destroyed or not espEnabled then
        clearESP()
        return
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        clearESP()
        return
    end

    local candidates = {}

    for _, entry in ipairs(modelCache.Entries) do
        if entry.Kind == "Mob" and entry.IsModel and isEntryAlive(entry) then
            local distance = (getEntryPosition(entry) - root.Position).Magnitude

            if distance <= SETTINGS.ESPRadius then
                table.insert(candidates, {
                    Object = entry.Object,
                    Distance = distance,
                })
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.Distance < b.Distance
    end)

    local wanted = {}
    local amount = math.min(#candidates, SETTINGS.MaxESPHighlights)

    for index = 1, amount do
        local object = candidates[index].Object
        wanted[object] = true
        createESP(object)
    end

    for object, highlight in pairs(espHighlights) do
        if not wanted[object] then
            highlight:Destroy()
            espHighlights[object] = nil
        end
    end
end

