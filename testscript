local function startMobMount(entry, savedState)
    if mountState then
        stopMount(false)
    end

    local character = savedState.Character
    local humanoid = savedState.Humanoid
    local root = savedState.Root

    if not character.Parent or not humanoid.Parent or not root.Parent or not isEntryAlive(entry) then
        restoreCharacterState(savedState, true)
        return false
    end

    mountState = {
        Entry = entry,
        GroupId = selectedTarget and selectedTarget.GroupId,
        Character = character,
        Humanoid = humanoid,
        Root = root,
        RootToPivot = savedState.RootToPivot,
        SavedState = savedState,
    }

    mountConnection = RunService.RenderStepped:Connect(function()
        local state = mountState
        if not state or destroyed then
            return
        end

        if not state.Character.Parent or not state.Root.Parent or not state.Humanoid.Parent then
            stopMount(false)
            return
        end

        if not isEntryAlive(state.Entry) then
            local oldGroupId = state.GroupId
            stopMount(true)

            if selectedTarget and selectedTarget.GroupId == oldGroupId then
                selectedTarget.CurrentEntry = nil
                updateSelectedStatus()
            end

            feedbackLabel.Text = "TARGET LOST - SAME GROUP REACQUIRED"
            return
        end

        local targetCFrame = getObjectTopFollowCFrame(state.Entry)
        if targetCFrame then
            state.Character:PivotTo(targetCFrame * state.RootToPivot)
        end
    end)

    return true
end

