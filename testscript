updateSelectedStatus = function()
    if autoFarmEnabled then
        if farmCurrentTarget and isCachedModelUsable(farmCurrentTarget, "Mobs") then
            modelStatus.Text = "AUTOFARMING: " .. string.upper(farmCurrentTarget.Name)
        else
            modelStatus.Text = "AUTOFARM: SEARCHING NEARBY MOBS"
        end
        teleportButton.Active = not teleporting
        teleportButton.Text = teleporting and "MOVING..." or "AUTOFARM: ON"
        return
    end

    if not selectedTarget then
        selectedLabel.Text = "NONE"
        modelStatus.Text = "STATUS: NOT SELECTED"
        teleportButton.Active = teleportModeEnabled
        teleportButton.Text = teleportModeEnabled and "TELEPORT: ON" or "TELEPORT TO MODEL"
        return
    end

    local target = selectedTarget
    local model = resolveSelectedModel(target)
    local count = countAvailable(target.Folder, target.Name)

    selectedLabel.Text = "[" .. target.Folder .. "] "
        .. target.Name
        .. " | "
        .. count
        .. " AVAILABLE"

    if not model then
        if target.Folder == "Mobs" then
            modelStatus.Text = "NO LIVING MOB FOUND"
        elseif target.Folder == "NPCs" then
            modelStatus.Text = "CURRENT NPC UNAVAILABLE"
        else
            modelStatus.Text = "NO LIVING TARGET FOUND"
        end
        local canSearchSelectedMob = target.Folder == "Mobs"
            and mobTeleportEnabled
            and backFollowEnabled
        teleportButton.Active = teleportModeEnabled or canSearchSelectedMob
        if teleportModeEnabled then
            teleportButton.Text = "TELEPORT: ON"
        elseif canSearchSelectedMob then
            teleportButton.Text = "SEARCH SELECTED MOB"
        else
            teleportButton.Text = "NO AVAILABLE TARGET"
        end
        return
    end

    if teleporting then
        modelStatus.Text = "TARGET: " .. model.Name .. " / MOVING"
        teleportButton.Active = false
        teleportButton.Text = "MOVING..."
        return
    end

    if teleportModeEnabled then
        if mountState and mountState.Model == model then
            modelStatus.Text = "FOLLOWING SELECTED MOB / CLICK TO STOP"
        else
            modelStatus.Text = "TELEPORT MODE ACTIVE / CLICK TO STOP"
        end
        teleportButton.Active = true
        teleportButton.Text = "TELEPORT: ON"
        return
    end

    if mountState and mountState.Model == model then
        modelStatus.Text = farmPositionMode == "UPPER"
            and "LYING FACE-DOWN ABOVE THE MOB"
            or "LYING FACE-UP UNDER THE MOB"
        teleportButton.Active = false
        teleportButton.Text = "MOUNTED"
        return
    end

    if target.Folder == "Mobs" and not mobTeleportEnabled then
        modelStatus.Text = "AVAILABLE / MOB TP OFF"
        teleportButton.Active = false
        teleportButton.Text = "MOB TELEPORT OFF"
        return
    end

    if target.Folder == "Mobs" then
        modelStatus.Text = "AUTO NEXT SAME-NAME MOB ENABLED"
    elseif target.Folder == "NPCs" then
        modelStatus.Text = "NPC TARGET AVAILABLE"
    else
        modelStatus.Text = "TARGET AVAILABLE / AUTO NEXT SAME-NAME"
    end

    teleportButton.Active = true
    teleportButton.Text = "TELEPORT TO SELECTED MODEL"
end

