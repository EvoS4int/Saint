        TextSize = 9,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        LayoutOrder = index,
        ZIndex = 21,
    }, dropdownList)

    addCorner(option, 5)
    addStroke(option, 0.55, 1)

    create("UIPadding", {
        PaddingLeft = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8),
    }, option)

    table.insert(dropdownRows, {
        Button = option,
        Group = group,
    })

    option.Activated:Connect(function()
        if teleporting then
            return
        end

        if mountState and (
            group.Folder ~= "Mobs" or group.Name ~= mountState.Name
        ) then
            stopMount()
        end

        selectedTarget = {
            Folder = group.Folder,
            Name = group.Name,
            CurrentModel = findNearestLiveModel(group.Folder, group.Name),
        }

        dropdownButton.Text = "[" .. group.Folder .. "] " .. group.Name .. " ▼"
        dropdownList.Visible = false
        feedbackLabel.Text = "SELECTED GROUP: " .. group.Name
        updateSelectedStatus()
    end)
end

-- Every word you type must match the model name or its folder name,
-- e.g. "thief npcs" or "iron ores".
local function searchModels()
    clearDropdown()

    local tokens = {}
    for token in string.gmatch(string.lower(searchBox.Text), "%S+") do
        table.insert(tokens, token)
    end

    local matches = {}

    for _, group in ipairs(modelCache.Groups) do
        local matched = true

        for _, token in ipairs(tokens) do
            if not string.find(group.Lower, token, 1, true)
                and not string.find(group.FolderLower, token, 1, true) then
                matched = false
                break
            end
        end

        if matched then
            table.insert(matches, group)
        end
    end

    local shown = math.min(#matches, SETTINGS.MaxDropdownRows)

    if shown < #matches then
        countLabel.Text = "FOUND " .. #matches .. " GROUPS / SHOWING FIRST " .. shown
    else
        countLabel.Text = "FOUND " .. #matches .. " GROUPS"
    end

    if #matches == 0 then
        create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 29),
            BackgroundTransparency = 1,
            Text = "NO MODELS FOUND",
            TextColor3 = COLORS.White,
            TextSize = 9,
            Font = Enum.Font.Gotham,
            ZIndex = 21,
        }, dropdownList)
    else
        for index = 1, shown do
            createDropdownRow(matches[index], index)
        end
    end

    updateSelectedStatus()
end

------------------------------------------------------------------------
-- TELEPORT
------------------------------------------------------------------------

local function smoothTeleport(target)
    if teleporting or not target then
        return
    end

    if mountState then
        stopMount()
    end

    local isNPC = target.Folder == "NPCs"
    local isMob = target.Folder == "Mobs"

    if isMob and not mobTeleportEnabled then
        feedbackLabel.Text = "MOB TELEPORT IS OFF"
        return
    end

    local model = resolveSelectedModel(target)
    if not model then
        feedbackLabel.Text = "NO LIVING TARGET FOUND"
        updateSelectedStatus()
        return
    end

    local character = player.Character
    if not character then
        feedbackLabel.Text = "CHARACTER NOT LOADED"
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        feedbackLabel.Text = "CHARACTER NOT READY"
        return
    end

    local destination
    if isNPC then
        destination = SETTINGS.NPCWorldPivot
    elseif isMob then
        destination = getMobUnderCFrame(model)
        if not destination then
            feedbackLabel.Text = "CANNOT FIND MOB POSITION"
            return
        end
    else
        destination = getObjectTopCFrame(model, SETTINGS.OtherClearance)
        if not destination then
            feedbackLabel.Text = "CANNOT FIND TARGET POSITION"
            return
        end
    end

    local startingPosition
    if isNPC then
        startingPosition = destination
            * CFrame.new(0, -SETTINGS.NPCBelowDistance, 0)
    else
        startingPosition = destination
    end

    local distance = (startingPosition.Position - root.Position).Magnitude
    local travelDuration = math.clamp(
        distance / SETTINGS.TeleportSpeed,
        SETTINGS.MinDuration,
        SETTINGS.MaxDuration
    )

    teleporting = true
    updateSelectedStatus()

    local savedState = captureCharacterState(character, humanoid, root)
    activeSavedState = savedState
    local rootToPivot = savedState.RootToPivot

    local success, err = pcall(function()
        humanoid:ChangeState(Enum.HumanoidStateType.Physics)

        if isMob then
            local mobForward = getMobForward(model)

            local proneStart = CFrame.lookAt(
                root.Position,
                root.Position + Vector3.new(0, 1, 0),
                mobForward
            )

            feedbackLabel.Text = "MOVING FACE-UP UNDER THE MOB..."

            playCharacterTween(
                character,
                proneStart,
                rootToPivot,
                SETTINGS.LayDuration,
                Enum.EasingStyle.Sine
            )

            feedbackLabel.Text = "MOVING UNDER THE MOB..."

            chaseMobUnder(character, rootToPivot, model, proneStart)
        elseif isNPC then
            local npcStart = destination
                * CFrame.new(0, -SETTINGS.NPCBelowDistance, 0)
                * CFrame.Angles(math.rad(90), 0, 0)

            feedbackLabel.Text = "APPROACHING NPC..."

            playCharacterTween(
                character,
                npcStart,
                rootToPivot,
                travelDuration,
                Enum.EasingStyle.Linear
            )

            feedbackLabel.Text = "SLOWLY ASCENDING..."

            playCharacterTween(
                character,
                destination * CFrame.Angles(math.rad(90), 0, 0),
                rootToPivot,
                SETTINGS.NPCRiseDuration,
                Enum.EasingStyle.Sine
            )

            feedbackLabel.Text = "STANDING UP..."

            playCharacterTween(
                character,
                destination,
                rootToPivot,
                SETTINGS.StandDuration,
                Enum.EasingStyle.Sine
            )
        else
            feedbackLabel.Text = "MOVING TO " .. string.upper(model.Name) .. "..."

            playCharacterTween(
                character,
                destination,
                rootToPivot,
                travelDuration,
                Enum.EasingStyle.Sine,
                model,
                target.Folder
            )

            if not isCachedModelUsable(model, target.Folder) then
                error("TARGET REMOVED DURING TRAVEL")
            end
        end
    end)

    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end

    if activeDriver then
        activeDriver:Destroy()
        activeDriver = nil
    end

    teleporting = false

    local shouldMount = success
        and isMob
        and backFollowEnabled
        and isCachedModelUsable(model, "Mobs")

    if shouldMount then
        startMobMount(model, savedState)
    else
        restoreCharacterState(savedState, true)
    end

    updateSelectedStatus()

    if success then
        if isNPC then
            feedbackLabel.Text = "ARRIVED AT NPC WORLD PIVOT"
        elseif shouldMount then
            feedbackLabel.Text = "LYING FACE-UP UNDER THE MOB"
        else
            feedbackLabel.Text = "ARRIVED ABOVE " .. target.Name
        end
    elseif isMob and not isCachedModelUsable(model, "Mobs") then
        feedbackLabel.Text = "MOB DIED - NEXT SAME-NAME TARGET SELECTED"
    elseif not isNPC and not isMob and not isCachedModelUsable(model, target.Folder) then
        feedbackLabel.Text = "TARGET REMOVED - NEXT SAME-NAME TARGET SELECTED"
    else
        feedbackLabel.Text = "FAILED: " .. tostring(err)
    end
end

