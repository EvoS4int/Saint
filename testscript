local function getTeleportPart(model)
    if not model or not model:IsA("Model") then
        return nil
    end

    if model.PrimaryPart and model.PrimaryPart:IsA("BasePart") then
        return model.PrimaryPart
    end

    return model:FindFirstChildWhichIsA("BasePart", true)
end

local function getHumanoid(model)
    if not model then
        return nil
    end

    return model:FindFirstChildWhichIsA("Humanoid", true)
end

local function isAlive(model, humanoid)
    if not model or not model.Parent then
        return false
    end

    if humanoid and humanoid.Parent and humanoid.Health <= 0 then
        return false
    end

    return true
end

local modelCache = {
    ModelsByFolder = {
        Mobs = {},
        NPCs = {},
    },

    ByName = {
        Mobs = {},
        NPCs = {},
    },

    Counts = {
        Mobs = {},
        NPCs = {},
    },

    Parts = {},
    Humanoids = {},
    Groups = {},
}

local function getTopLevelModels(folder)
    if not folder then
        return {}
    end

    local results = {}

    for _, object in ipairs(folder:GetDescendants()) do
        if object:IsA("Model") then
            local ancestor = object.Parent
            local nested = false

            while ancestor and ancestor ~= folder do
                if ancestor:IsA("Model") then
                    nested = true
                    break
                end

                ancestor = ancestor.Parent
            end

            if not nested then
                table.insert(results, object)
            end
        end
    end

    return results
end

local function refreshModelCache()
    local newCache = {
        ModelsByFolder = {
            Mobs = {},
            NPCs = {},
        },

        ByName = {
            Mobs = {},
            NPCs = {},
        },

        Counts = {
            Mobs = {},
            NPCs = {},
        },

        Parts = {},
        Humanoids = {},
        Groups = {},
    }

    for _, folderName in ipairs({"Mobs", "NPCs"}) do
        local folder = getFolder(folderName)

        if folder then
            local models = getTopLevelModels(folder)

            newCache.ModelsByFolder[folderName] = models

            for _, model in ipairs(models) do
                local name = model.Name

                local part = getTeleportPart(model)
                local humanoid = getHumanoid(model)

                newCache.Parts[model] = part
                newCache.Humanoids[model] = humanoid

                local group = newCache.ByName[folderName][name]

                if not group then
                    group = {}
                    newCache.ByName[folderName][name] = group
                end

                table.insert(group, model)

                if part and isAlive(model, humanoid) then
                    newCache.Counts[folderName][name] =
                        (newCache.Counts[folderName][name] or 0) + 1
                end
            end

            for name in pairs(newCache.ByName[folderName]) do
                table.insert(newCache.Groups, {
                    Folder = folderName,
                    Name = name,
                })
            end
        end
    end

    table.sort(newCache.Groups, function(a, b)
        local nameA = a.Name:lower()
        local nameB = b.Name:lower()

        if nameA == nameB then
            return a.Folder < b.Folder
        end

        return nameA < nameB
    end)

    modelCache = newCache
end

local function isCachedModelUsable(model, folderName)
    if not model then
        return false
    end

    local folder = getFolder(folderName)

    if not folder or not model:IsDescendantOf(folder) then
        return false
    end

    local part = modelCache.Parts[model]

    if not part or not part:IsDescendantOf(model) then
        part = getTeleportPart(model)
        modelCache.Parts[model] = part
    end

    if not part then
        return false
    end

    local humanoid = modelCache.Humanoids[model]

    if not humanoid or not humanoid.Parent then
        humanoid = getHumanoid(model)
        modelCache.Humanoids[model] = humanoid
    end

    return isAlive(model, humanoid)
end

local function getGroupModels(folderName, modelName)
    local candidates =
        modelCache.ByName[folderName]
        and modelCache.ByName[folderName][modelName]

    if not candidates then
        return {}
    end

    local results = {}

    for _, model in ipairs(candidates) do
        if isCachedModelUsable(model, folderName) then
            table.insert(results, model)
        end
    end

    return results
end

local function countAvailable(folderName, modelName)
    local count = 0

    for _, model in ipairs(
        modelCache.ByName[folderName]
        and modelCache.ByName[folderName][modelName]
        or {}
    ) do
        if isCachedModelUsable(model, folderName) then
            count += 1
        end
    end

    return count
end

local function getModelPosition(model)
    local part = modelCache.Parts[model]

    if part and part.Parent then
        return part.Position
    end

    part = getTeleportPart(model)

    if part then
        modelCache.Parts[model] = part
        return part.Position
    end

    return model:GetPivot().Position
end

local function findNearestLiveModel(folderName, modelName)
    local models = getGroupModels(folderName, modelName)

    if #models == 0 then
        return nil
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    local origin = root and root.Position or Vector3.zero

    local closestModel = nil
    local closestDistance = math.huge

    for _, model in ipairs(models) do
        local distance = (
            getModelPosition(model) - origin
        ).Magnitude

        if distance < closestDistance then
            closestDistance = distance
            closestModel = model
        end
    end

    return closestModel
end

local function getTargetGroups()
    return modelCache.Groups
end

local function resolveSelectedModel(target)
    if not target then
        return nil
    end

    local current = target.CurrentModel

    if current and isCachedModelUsable(current, target.Folder) then
        return current
    end

    target.CurrentModel = nil

    if target.Folder == "Mobs" and SETTINGS.AutoNextMob then
        target.CurrentModel = findNearestLiveModel(
            "Mobs",
            target.Name
        )
    end

    return target.CurrentModel
end

local function clearESP()
    for model, highlight in pairs(espHighlights) do
        if highlight then
            highlight:Destroy()
        end

        espHighlights[model] = nil
    end
end

local function createESP(model)
    if espHighlights[model] then
        return espHighlights[model]
    end

    local highlight = Instance.new("Highlight")

    highlight.Name = "LocalMobESP"
    highlight.Adornee = model
    highlight.FillTransparency = 1
    highlight.OutlineColor = COLORS.White
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded

    highlight.Parent = model

    espHighlights[model] = highlight

    return highlight
end

local function updateESP()
    if destroyed or not espEnabled then
        clearESP()
        return
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        clearESP()
        return
    end

    local candidates = {}

    for _, model in ipairs(modelCache.ModelsByFolder.Mobs) do
        if isCachedModelUsable(model, "Mobs") then
            local distance = (
                getModelPosition(model) - root.Position
            ).Magnitude

            if distance <= SETTINGS.ESPRadius then
                table.insert(candidates, {
                    Model = model,
                    Distance = distance,
                })
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.Distance < b.Distance
    end)

    local wanted = {}

    local amount = math.min(
        #candidates,
        SETTINGS.MaxESPHighlights
    )

    for index = 1, amount do
        local model = candidates[index].Model

        wanted[model] = true
        createESP(model)
    end

    for model, highlight in pairs(espHighlights) do
        if not wanted[model] then
            highlight:Destroy()
