local function startCatalogBrowser()
    local TextService = game:GetService("TextService")
    local browserDestroyed = false
    local sectionByKey = {}
    local sectionStates = {}
    local categoryCache = {}
    local scanning = {}
    local rescanQueued = {}
    local watchedRoots = {}
    local visitedSections = {}
    local refreshTimers = {}
    local scheduleCategoryRefresh
    local refreshCategory
    local currentCategory = "Chests"
    local currentName = nil
    local currentEntry = nil
    local pendingOreTeleportName = nil
    -- Forward declarations allow Ore buttons to teleport immediately when clicked.
    local teleportEntry
    local getNearestEntry
    local namePageLimit = 250
    local instancePageLimit = 35
    local namePage = 1
    local instancePage = 1
    local maxNodesPerScan = 10000
    local refreshDebounce = 0.22
    local farmStates = {
        Ores = {Enabled = false, Token = 0, Name = nil, Target = nil, LastTargetObject = nil},
        Bosses = {Enabled = false, Token = 0, Name = nil, Target = nil, LastTargetObject = nil},
        Mobs = {Enabled = false, Token = 0, Name = nil, Target = nil, LastTargetObject = nil},
    }

    local function isFarmCategory(category)
        return farmStates[category] ~= nil
    end

    local function getFarmNoun(category)
        if category == "Ores" then return "ORE" end
        if category == "Mobs" then return "ENEMY" end
        return "BOSS"
    end

    -- Precompute these once; the resolver can run for thousands of models.
    local enemyCatalogLongestFirst = table.clone(CATALOGS.Enemies)
    table.sort(enemyCatalogLongestFirst, function(a, b)
        local na = string.gsub(string.lower(a), "[^%w]", "")
        local nb = string.gsub(string.lower(b), "[^%w]", "")
        return #na > #nb
    end)
    local enemyAttributeNames = {"EnemyName", "MobName", "DisplayName", "EntityName",
        "NPCName", "TargetName", "EnemyType", "MobType", "Type"}

    local function makeSet(values)
        local set = {}
        for _, value in ipairs(values or {}) do
            set[value] = true
        end
        return set
    end

    local function resolveOreCatalogName(rawName)
        if typeof(rawName) ~= "string" then
            return nil
        end

        local candidate = string.gsub(rawName, "^%s*(.-)%s*$", "%1")
        if candidate == "" then
            return nil
        end

        local lowered = string.lower(candidate)
        local compact = string.gsub(lowered, "[%s_%-]+", "")

        for _, catalogName in ipairs(CATALOGS.Ores) do
            local base = string.lower(catalogName)
            local normalized = string.gsub(base, "[%s_%-]+", "")
            if lowered == base or compact == normalized
                or compact == normalized .. "ore"
                or compact == normalized .. "ores"
                or compact == normalized .. "orenode"
                or compact == normalized .. "oredeposit" then
                return catalogName
            end
        end

        return nil
    end

    -- Bosses may be named with prefixes/suffixes by the game. Resolve these
    -- back to the predefined catalog so the Bosses tab does not depend on
    -- exact Model.Name equality.
    local function resolveBossCatalogName(rawName)
        if typeof(rawName) ~= "string" then
            return nil
        end

        local compact = string.lower(rawName)
        compact = string.gsub(compact, "[^%w]", "")
        if compact == "" then
            return nil
        end

        local prefixes = {"boss", "enemy", "mob", "npc", "model"}
        for _, prefix in ipairs(prefixes) do
            if string.sub(compact, 1, #prefix) == prefix then
                compact = string.sub(compact, #prefix + 1)
                break
            end
        end

        for _, catalogName in ipairs(CATALOGS.Bosses) do
            local target = string.lower(catalogName)
            target = string.gsub(target, "[^%w]", "")
            if compact == target or string.sub(compact, 1, #target) == target then
                local suffix = string.sub(compact, #target + 1)
                if suffix == "" or string.sub(suffix, 1, 4) == "boss"
                    or string.sub(suffix, 1, 5) == "level"
                    or string.sub(suffix, 1, 2) == "lv"
                    or string.sub(suffix, 1, 5) == "phase"
                    or string.match(suffix, "^%d") then
                    return catalogName
                end
            end
        end

        return nil
    end

    -- Normalize enemy names that the game may decorate with prefixes/suffixes.
    local function resolveEnemyCatalogName(rawName)
        if typeof(rawName) ~= "string" then return nil end
        local compact = string.lower(rawName)
        compact = string.gsub(compact, "[^%w]", "")
        if compact == "" then return nil end

        for _, prefix in ipairs({"enemy", "mob", "npc", "model", "boss"}) do
            if string.sub(compact, 1, #prefix) == prefix then
                compact = string.sub(compact, #prefix + 1)
                break
            end
        end

        for _, catalogName in ipairs(enemyCatalogLongestFirst) do
            local target = string.gsub(string.lower(catalogName), "[^%w]", "")
            if compact == target then return catalogName end
            if #target > 1 and string.sub(compact, 1, #target) == target then
                local suffix = string.sub(compact, #target + 1)
                if suffix == "boss" or suffix == "enemy" or suffix == "mob"
                    or suffix == "npc" or suffix == "model" or suffix == "clone"
                    or suffix == "spawn" or suffix == "copy"
                    or string.sub(suffix, 1, 5) == "level"
                    or string.sub(suffix, 1, 2) == "lv"
                    or string.sub(suffix, 1, 5) == "phase"
                    or string.match(suffix, "^%d") then
                    return catalogName
                end
            end
        end
        return nil
    end

    local function isPotentialEnemyObject(instance)
        if not instance then return false end
        if instance:IsA("Model") then
            if resolveEnemyCatalogName(instance.Name) then return true end
            for _, attributeName in ipairs(enemyAttributeNames) do
                if resolveEnemyCatalogName(instance:GetAttribute(attributeName)) then return true end
            end
            for _, child in ipairs(instance:GetChildren()) do
                if child:IsA("StringValue") and table.find(enemyAttributeNames, child.Name)
                    and resolveEnemyCatalogName(child.Value) then return true end
            end
        elseif instance:IsA("StringValue") and resolveEnemyCatalogName(instance.Value) then
            return true
        end
        return false
    end

    local function isPotentialOreObject(instance)
        if not instance then return false end
        if instance:IsA("Model") or instance:IsA("BasePart") then
            if resolveOreCatalogName(instance.Name) then return true end
            for _, attributeName in ipairs({"OreType", "OreName", "ResourceType", "Ore", "Type"}) do
                if resolveOreCatalogName(instance:GetAttribute(attributeName)) then return true end
            end
            for _, child in ipairs(instance:GetChildren()) do
                if child:IsA("StringValue")
                    and (child.Name == "OreType" or child.Name == "OreName"
                        or child.Name == "ResourceType" or child.Name == "Type")
                    and resolveOreCatalogName(child.Value) then
                    return true
                end
            end
        elseif instance:IsA("StringValue") and resolveOreCatalogName(instance.Value) then
            return true
        end
        return false
    end

    -- Workspace fallback watcher: detect relevant boss spawns without
    -- rescanning every time an unrelated map part is created.
    local function isPotentialBossObject(instance)
        if not instance then return false end

        if instance:IsA("Model") then
            if resolveBossCatalogName(instance.Name) then
                return true
            end

            for _, attributeName in ipairs({"BossName", "EnemyName", "DisplayName", "EntityName", "NPCName", "TargetName", "Type"}) do
                if resolveBossCatalogName(instance:GetAttribute(attributeName)) then
                    return true
                end
            end

            for _, child in ipairs(instance:GetChildren()) do
                if child:IsA("StringValue")
                    and (child.Name == "BossName" or child.Name == "EnemyName"
                        or child.Name == "DisplayName" or child.Name == "EntityName"
                        or child.Name == "NPCName" or child.Name == "Name" or child.Name == "Type")
                    and resolveBossCatalogName(child.Value) then
                    return true
                end
            end
        elseif instance:IsA("StringValue") and resolveBossCatalogName(instance.Value) then
            return true
        end

        return false
    end

    local definitions = {
        {Key = "Workspace", Label = "WORKSPACE", Mode = "workspace"},
        {Key = "Ores", Label = "ORES", Catalog = CATALOGS.Ores,
            Roots = {"Ores"}, FallbackRoots = {"Map", "Maps"}, Mode = "ore"},
        {Key = "OreRoutes", Label = "ORE LOCATIONS", Catalog = ORE_ROUTE_NAMES,
            StaticEntries = STATIC_DESTINATIONS.OreRoutes, Mode = "static"},
        {Key = "Zones", Label = "ZONES", Roots = {"Zones"}, Mode = "dynamic"},
        {Key = "Maps", Label = "MAPS", Catalog = MAP_PATH_CATALOG,
            Roots = {"Map", "Maps"}, Mode = "location"},
        {Key = "Mirrors", Label = "MIRRORS", Roots = {"Mirrors"}, Mode = "dynamic"},
        {Key = "Locations", Label = "LOCATIONS", Catalog = CATALOGS.Locations,
            Roots = {"Locations", "Areas", "TeleportPoints"}, FallbackRoots = {"Map", "Maps"}, Mode = "location"},
        -- Enemy discovery is intentionally limited to live Workspace roots.
        -- No Mobs/Enemies models are read from ReplicatedStorage.
        {Key = "Mobs", Label = "ENEMIES", Catalog = CATALOGS.Enemies,
            Roots = {"Mobs", "Enemies"}, Mode = "character"},
        {Key = "NPCs", Label = "NPC LOCATIONS", Roots = {"NPCs", "NPC", "NonPlayerCharacters"},
            StaticEntries = STATIC_DESTINATIONS.NPCs, Mode = "npc"},
        {Key = "GoldChests", Label = "GOLD CHESTS", Roots = {"GoldChests"}, Mode = "dynamic"},
        {Key = "Chests", Label = "CHESTS", Roots = {"Chests"},
            StaticEntries = STATIC_DESTINATIONS.Chests, Mode = "dynamic"},
        {Key = "ChestSpawns", Label = "CHEST SPAWNS", Roots = {"ChestSpawns"}, Mode = "dynamic"},
        {Key = "Bushes", Label = "BUSHES", Roots = {"Bushes"}, Mode = "dynamic"},
        {Key = "Beds", Label = "BEDS", Roots = {"Beds"}, Mode = "dynamic"},
        {Key = "Bosses", Label = "BOSSES", Catalog = CATALOGS.Bosses,
            Roots = {"Bosses", "Mobs", "Enemies"}, Mode = "boss"},
        {Key = "AreaBosses", Label = "AREA BOSSES", StaticEntries = STATIC_DESTINATIONS.AreaBosses, Mode = "static"},
        {Key = "Shops", Label = "SHOPS", Catalog = CATALOGS.Shops,
            Roots = {"Shops", "ShopNPCs", "NPCs", "NPC", "NonPlayerCharacters"}, Mode = "shop"},
