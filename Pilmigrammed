end)

-- Auto search: the list updates by itself shortly after you type
connectGlobal(searchBox:GetPropertyChangedSignal("Text"), function()
    searchToken = searchToken + 1
    local token = searchToken

    task.delay(SETTINGS.AutoSearchDelay, function()
        if token ~= searchToken or destroyed or not gui.Parent then
            return
        end

        searchModels()
        dropdownList.Visible = true
    end)
end)

dropdownButton.Activated:Connect(function()
    dropdownList.Visible = not dropdownList.Visible
    if dropdownList.Visible then
        searchModels()
    end
end)

mobToggleButton.Activated:Connect(function()
    if teleporting then
        feedbackLabel.Text = "WAIT UNTIL TELEPORT FINISHES"
        return
    end

    mobTeleportEnabled = not mobTeleportEnabled
    SETTINGS.MobTeleportEnabled = mobTeleportEnabled
    if not mobTeleportEnabled and autoFarmEnabled then
        setAutoFarmEnabled(false)
    end
    updateMobToggle()
    updateSelectedStatus()
end)

espToggleButton.Activated:Connect(function()
    espEnabled = not espEnabled
    SETTINGS.ESPEnabled = espEnabled
    updateESPToggle()
    updateESP()
end)

backFollowButton.Activated:Connect(function()
    if teleporting then
        feedbackLabel.Text = "WAIT UNTIL TELEPORT FINISHES"
        return
    end

    backFollowEnabled = not backFollowEnabled
    SETTINGS.MobBackFollowEnabled = backFollowEnabled
    updateBackFollowToggle()

    if not backFollowEnabled then
        if autoFarmEnabled then
            setAutoFarmEnabled(false)
        end
        if mountState then
            teleportModeEnabled = false
            mobSearchToken = mobSearchToken + 1
            stopMount()
        elseif selectedTarget and selectedTarget.Folder == "Mobs" and teleportModeEnabled then
            teleportModeEnabled = false
            mobSearchToken = mobSearchToken + 1
        end
        feedbackLabel.Text = "UNDER FOLLOW DISABLED"
    else
        feedbackLabel.Text = backFollowEnabled
            and "UNDER FOLLOW ENABLED"
            or "UNDER FOLLOW DISABLED"
    end

    updateSelectedStatus()
end)

------------------------------------------------------------------------
-- CLEANUP
------------------------------------------------------------------------

local function cleanup()
    if destroyed then
        return
    end

    destroyed = true
    dragging = false
    dragInput = nil

    autoClickEnabled = false
    SETTINGS.AutoClickEnabled = false
    teleportModeEnabled = false
    mobSearchToken = mobSearchToken + 1
    autoFarmEnabled = false
    autoFarmToken = autoFarmToken + 1
    autoChestEnabled = false
    autoGPromptEnabled = false
    SETTINGS.AutoChestEnabled = false
    SETTINGS.AutoGPromptEnabled = false
    autoChestToken = autoChestToken + 1
    autoChestBusy = false
    farmCurrentTarget = nil
    lastReturnPivot = nil
    deactivateEquippedTool()

    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end

    if activeDriver then
        activeDriver:Destroy()
        activeDriver = nil
    end

    stopMount()

    if activeSavedState then
        restoreCharacterState(activeSavedState, true)
    end

    clearESP()
    stopNoclip()

    -- Restore the user's original camera occlusion behavior when this GUI closes.
    pcall(function()
        player.DevCameraOcclusionMode = originalCameraOcclusionMode
            or Enum.DevCameraOcclusionMode.Zoom
    end)
    cameraNoclipEnabled = false
    SETTINGS.CameraNoclipEnabled = false

    for _, connection in ipairs(globalConnections) do
        connection:Disconnect()
    end
    table.clear(globalConnections)
end

destroyButton.Activated:Connect(function()
    cleanup()
    gui:Destroy()
end)

gui.Destroying:Connect(cleanup)

