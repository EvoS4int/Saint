-- Keep startup result variables scoped so they do not consume permanent
-- top-level local slots in this large integrated script.
do
    setStartupStatus("starting catalog browser")
    print("[Pilgrammedscript] Starting catalog browser...")
    local browserResult = {pcall(startCatalogBrowser)}
    if not browserResult[1] then
        warn("[Pilgrammedscript] Catalog browser startup failed: " .. tostring(browserResult[2]))
    else
        print("[Pilgrammedscript] Catalog browser ready.")
    end
end

do
    setStartupStatus("starting main interface logic")
    print("[Pilgrammedscript] Starting main interface logic...")
    local logicResult = {pcall(startLogic)}
    if logicResult[1] then
        print("[Pilgrammedscript] Loaded successfully.")
        if startupDiagnostics.Gui and startupDiagnostics.Gui.Parent then
            startupDiagnostics.Gui:Destroy()
        end
    else
        warn("[Pilgrammedscript] Startup error: " .. tostring(logicResult[2]))
        setStartupStatus("startup error - check executor console")
        if feedbackLabel and feedbackLabel.Parent then
            feedbackLabel.Text = "STARTUP ERROR - CHECK EXECUTOR CONSOLE"
        end
    end
end
