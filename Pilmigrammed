            farmButton.Text = "AUTO " .. getFarmNoun(category)
                .. " FARM " .. (farmState.Enabled and "ON" or "OFF")
            setToggleVisual(farmButton, farmState.Enabled)
        end
        if category == "Locations" or category == "Shops" then
            detailLabel.Text = category == "Locations"
                and "LOCATIONS ARE TELEPORT DESTINATIONS, NOT COMBAT TARGETS"
                or "SHOPS ARE NPC DESTINATIONS, NOT COMBAT TARGETS"
        elseif category == "OreRoutes" then
