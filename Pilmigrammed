        if property == "Name" and typeof(value) == "string"
            and value ~= GUI_NAME
            and string.sub(value, 1, #GUI_CHILD_PREFIX) ~= GUI_CHILD_PREFIX then
            value = GUI_CHILD_PREFIX .. value
        end

        local propertyOk, propertyErr = pcall(function()
            object[property] = value
        end)
        if not propertyOk then
            warn("[Pilgrammedscript] UI property failed: " .. className .. "." .. property .. " / " .. tostring(propertyErr))
        end
    end

    local parentOk, parentErr = pcall(function()
        object.Parent = parent
    end)
    if not parentOk and parent ~= playerGui then
        warn("[Pilgrammedscript] UI parent failed; retrying PlayerGui: " .. tostring(parentErr))
        parentOk, parentErr = pcall(function()
            object.Parent = playerGui
        end)
    end
    if not parentOk then
        warn("[Pilgrammedscript] Could not parent " .. className .. ": " .. tostring(parentErr))
    end

    return object
end

