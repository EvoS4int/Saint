local function smoothTeleport(target, autoFarmMode)
    if teleporting or not target then
        return
    end

    if mountState then
        stopMount()
    end

    local isNPC = target.Folder == "NPCs"
    local isMob = target.Folder == "Mobs"

    if isMob and not mobTeleportEnabled then
        feedbackLabel.Text = "MOB TELEPORT IS OFF"
        return
    end

    local model = resolveSelectedModel(target)
    if not model then
        feedbackLabel.Text = "NO LIVING TARGET FOUND"
        updateSelectedStatus()
        return
    end

    local character = player.Character
    if not character then
        feedbackLabel.Text = "CHARACTER NOT LOADED"
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        feedbackLabel.Text = "CHARACTER NOT READY"
        return
    end

    local destination
    if isNPC then
        destination = SETTINGS.NPCWorldPivot
    elseif isMob then
        destination = getMobUnderCFrame(model)
        if not destination then
            feedbackLabel.Text = "CANNOT FIND MOB POSITION"
            return
        end
    else
        destination = getObjectTopCFrame(model, SETTINGS.OtherClearance)
        if not destination then
            feedbackLabel.Text = "CANNOT FIND TARGET POSITION"
            return
        end
    end

    local startingPosition
    if isNPC then
        startingPosition = destination
            * CFrame.new(0, -SETTINGS.NPCBelowDistance, 0)
    else
        startingPosition = destination
    end

    if not lastReturnPivot then
        lastReturnPivot = character:GetPivot()
    end
    returnButton.Active = true
    teleportModeEnabled = true

    local distance = (startingPosition.Position - root.Position).Magnitude
    local travelDuration = math.clamp(
        distance / SETTINGS.TeleportSpeed,
        SETTINGS.MinDuration,
        SETTINGS.MaxDuration
    )

    teleporting = true
    updateSelectedStatus()

    local savedState = captureCharacterState(character, humanoid, root)
    activeSavedState = savedState
    local rootToPivot = savedState.RootToPivot

    local success, err = pcall(function()
        humanoid:ChangeState(Enum.HumanoidStateType.Physics)

        if isMob then
            local mobForward = getMobForward(model)

            local proneStart = CFrame.lookAt(
                root.Position,
                root.Position + Vector3.new(0, 1, 0),
                mobForward
            )

            feedbackLabel.Text = "MOVING FACE-UP UNDER THE MOB..."

            playCharacterTween(
                character,
                proneStart,
                rootToPivot,
                SETTINGS.LayDuration,
                Enum.EasingStyle.Sine
            )

            feedbackLabel.Text = "MOVING UNDER THE MOB..."

            chaseMobUnder(character, rootToPivot, model, proneStart)
        elseif isNPC then
            local npcStart = destination
                * CFrame.new(0, -SETTINGS.NPCBelowDistance, 0)
                * CFrame.Angles(math.rad(90), 0, 0)

            feedbackLabel.Text = "APPROACHING NPC..."

            playCharacterTween(
                character,
                npcStart,
                rootToPivot,
                travelDuration,
                Enum.EasingStyle.Linear
            )

            feedbackLabel.Text = "SLOWLY ASCENDING..."

            playCharacterTween(
                character,
                destination * CFrame.Angles(math.rad(90), 0, 0),
                rootToPivot,
                SETTINGS.NPCRiseDuration,
                Enum.EasingStyle.Sine
            )

            feedbackLabel.Text = "STANDING UP..."

            playCharacterTween(
                character,
                destination,
                rootToPivot,
                SETTINGS.StandDuration,
                Enum.EasingStyle.Sine
            )
        else
            feedbackLabel.Text = "MOVING TO " .. string.upper(model.Name) .. "..."

            playCharacterTween(
                character,
                destination,
                rootToPivot,
                travelDuration,
                Enum.EasingStyle.Sine,
                model,
                target.Folder
            )

            if not isCachedModelUsable(model, target.Folder) then
                error("TARGET REMOVED DURING TRAVEL")
            end
        end
    end)

    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end

    if activeDriver then
        activeDriver:Destroy()
        activeDriver = nil
    end

    teleporting = false

    if not success and not (isMob and backFollowEnabled and teleportModeEnabled) then
        teleportModeEnabled = false
    end

    -- For mobs, keep the prone mount active even if the target vanished during
    -- travel. The mount will search the selected same-name group and remain down.
    local shouldMount = isMob
        and backFollowEnabled
        and teleportModeEnabled

    if shouldMount then
        startMobMount(model, savedState, autoFarmMode)
        if autoFarmMode then
            farmCurrentTarget = model
        end
    else
        restoreCharacterState(savedState, true)
    end

    updateSelectedStatus()

    if success then
        if isNPC then
            feedbackLabel.Text = "ARRIVED AT NPC WORLD PIVOT"
        elseif shouldMount then
            feedbackLabel.Text = autoFarmMode
                and ("AUTOFARM: FOLLOWING " .. string.upper(model.Name))
                or (farmPositionMode == "UPPER" and "LYING FACE-DOWN ABOVE THE MOB" or "LYING FACE-UP UNDER THE MOB")
        else
            feedbackLabel.Text = "ARRIVED ABOVE " .. target.Name
        end
    elseif isMob and not isCachedModelUsable(model, "Mobs") then
        feedbackLabel.Text = "MOB DIED - NEXT SAME-NAME TARGET SELECTED"
    elseif not isNPC and not isMob and not isCachedModelUsable(model, target.Folder) then
        feedbackLabel.Text = "TARGET REMOVED - NEXT SAME-NAME TARGET SELECTED"
    else
        feedbackLabel.Text = "FAILED: " .. tostring(err)
    end
end

