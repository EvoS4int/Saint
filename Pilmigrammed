-- This interface must run on the client. Waiting briefly for LocalPlayer
-- avoids exiting before the client finishes initializing.
if not RunService:IsClient() then
    warn("[Pilgrammedscript] Client GUI cannot run from a server Script. Use a LocalScript in StarterPlayerScripts.")
    return
end

local player = Players.LocalPlayer
while not player do
    task.wait(0.1)
    player = Players.LocalPlayer
end

local playerGui = player:WaitForChild("PlayerGui", 15)
if not playerGui then
    warn("[Pilgrammedscript] PlayerGui was not available after 15 seconds. Re-run after the game finishes loading.")
    return
end

