    end

    local function openAutomation()
        catalogCurrentSection = "Automation"
        currentCategory = "Automation"
        panel.Visible = false
        left.Visible = true
        right.Visible = true
        for _, child in ipairs(nav:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundColor3 = COLORS.Element
                child.TextColor3 = COLORS.Gray
