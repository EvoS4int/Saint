------------------------------------------------------------------------
-- STATIC WORLD DESTINATIONS
-- Coordinates are loaded from the supplied location catalog. These are
-- client-side destinations rendered inside the same clean catalog container.
------------------------------------------------------------------------
local function parseStaticDestinations(raw, pathPrefix)
    local entries = {}
    local nameCounts = {}

    for line in string.gmatch(raw, "[^\r\n]+") do
        local name, info, rawNumbers = string.match(line, "^(.-)|(.-)|(.*)$")
        if name and rawNumbers then
            local values = {}
            for token in string.gmatch(rawNumbers, "[^,]+") do
                local value = tonumber(string.gsub(token, "^%s*(.-)%s*$", "%1"))
                if value ~= nil then
                    table.insert(values, value)
                end
            end

            if #values == 12 then
                nameCounts[name] = (nameCounts[name] or 0) + 1
                local index = nameCounts[name]
                local detail = info ~= "" and info or "WORLD DESTINATION"
                table.insert(entries, {
                    Name = name,
                    Info = detail,
                    CFrame = CFrame.new(table.unpack(values)),
                    Path = string.upper(pathPrefix) .. " / " .. name .. " / " .. detail
                        .. " / POINT " .. string.format("%02d", index),
                })
            else
                warn("[Pilgrammedscript] Skipped invalid static destination: " .. tostring(name))
            end
        end
    end

    return entries
end

