local function applyZektonToTextObject(object)
    if not object then return end
    if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
        -- SciFi is Roblox's Enum.Font mapping for the Zekton font family.
        pcall(function() object.Font = Enum.Font.SciFi end)
        if leaderboardState.FontFace then
            pcall(function() object.FontFace = leaderboardState.FontFace end)
        end
    end
end

local function applyZektonToTree(root)
    if not root then return end
    applyZektonToTextObject(root)
    for _, descendant in ipairs(root:GetDescendants()) do
        applyZektonToTextObject(descendant)
    end
end

local function getLeaderboardNameButton(row)
    if not row or not row:IsA("Frame") then return nil end
    local button = row:FindFirstChild("TextButton")
    if button and button:IsA("TextButton") then
        return button
    end
    return nil
end

local function setLeaderboardRgbEnabled(enabled)
    leaderboardState.RgbEnabled = enabled == true
    leaderboardState.RgbButton.Text = leaderboardState.RgbEnabled and "RGB: ON" or "RGB: OFF"
    setToggleVisual(leaderboardState.RgbButton, leaderboardState.RgbEnabled)
end

local function applyLeaderboardRgbNames()
    if not leaderboardState.StyleReady or not leaderboardState.ScrollingFrame then return end

    local rowIndex = 0
    for _, row in ipairs(leaderboardState.ScrollingFrame:GetChildren()) do
        if row:IsA("Frame") and row.Visible then
            local nameButton = getLeaderboardNameButton(row)
            if nameButton then
                rowIndex += 1
                if leaderboardState.RgbEnabled then
                    local hue = (os.clock() * 0.12 + rowIndex * 0.075) % 1
                    nameButton.TextColor3 = Color3.fromHSV(hue, 0.88, 1)
                else
                    local savedColor = row:GetAttribute("Color")
                    if typeof(savedColor) == "Color3" then
                        nameButton.TextColor3 = savedColor
                    end
                end
            end
        end
    end
end

local function attachLeaderboardAppearance()
    task.spawn(function()
        local deadline = os.clock() + 45
        local screenGui = nil
        local board = nil

        while not destroyed and gui.Parent and os.clock() < deadline do
            screenGui = playerGui:FindFirstChild("ScreenGui")
            board = screenGui and screenGui:FindFirstChild("Leaderboard")
            if board then break end
            task.wait(0.5)
        end

        if destroyed or not gui.Parent then return end
        if not board then
            leaderboardState.StyleDescription.Text = "LEADERBOARD NOT FOUND / FONT SETTING READY"
            return
        end

        local frame = board:FindFirstChild("Frame")
        local scrolling = frame and frame:FindFirstChild("ScrollingFrame")
        local example = board:FindFirstChild("Example")

        if not frame or not scrolling or not example then
            leaderboardState.StyleDescription.Text = "LEADERBOARD UI HIERARCHY NOT FOUND"
            warn("[Pilgrammedscript] Leaderboard styling skipped: expected ScreenGui.Leaderboard.Frame.ScrollingFrame and Example.")
            return
        end

        leaderboardState.Gui = board
        leaderboardState.ScrollingFrame = scrolling
        leaderboardState.Example = example
        leaderboardState.StyleReady = true

        -- Apply Zekton to the template and every existing row. The game's
        -- original LeaderboardScript remains enabled to preserve its party logic.
        applyZektonToTree(leaderboardState.Gui)

        connectGlobal(scrolling.DescendantAdded, function(descendant)
            applyZektonToTextObject(descendant)
        end)

        connectGlobal(scrolling.ChildAdded, function(child)
            applyZektonToTree(child)
        end)

        connectGlobal(scrolling.ChildRemoved, function()
            task.defer(applyLeaderboardRgbNames)
        end)

        leaderboardState.StyleDescription.Text = "FONT: ZEKTON / RGB USERNAMES"
        applyLeaderboardRgbNames()

        -- Update only visible player rows; original Party/Guild colors are restored
        -- from each row's Color attribute whenever RGB is turned off.
        task.spawn(function()
            while not destroyed and gui.Parent and leaderboardState.StyleReady do
                if leaderboardState.RgbEnabled then
                    applyLeaderboardRgbNames()
                end
                task.wait(0.05)
            end
        end)
    end)
end

leaderboardState.RgbButton.Activated:Connect(function()
    setLeaderboardRgbEnabled(not leaderboardState.RgbEnabled)
    applyLeaderboardRgbNames()
end)

setLeaderboardRgbEnabled(false)
attachLeaderboardAppearance()

