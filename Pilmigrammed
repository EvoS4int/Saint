local dragging = false
local dragInput = nil
local dragStart = nil
local dragStartCenter = nil

connectGlobal(dragHandle.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        dragStartCenter = main.AbsolutePosition + main.AbsoluteSize * 0.5
        if input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end
end)

connectGlobal(UserInputService.InputChanged, function(input)
    if not dragging then
        return
    end

    local mouseMovement = input.UserInputType == Enum.UserInputType.MouseMovement
    local touchMovement = input == dragInput

    if mouseMovement or touchMovement then
        local delta = input.Position - dragStart
        local viewport = getViewportSize()
        local size = main.AbsoluteSize
        local halfWidth = size.X * 0.5
        local halfHeight = size.Y * 0.5
        local margin = 10

        local minX = math.min(halfWidth + margin, viewport.X * 0.5)
        local maxX = math.max(viewport.X - halfWidth - margin, minX)
        local minY = math.min(halfHeight + margin, viewport.Y * 0.5)
        local maxY = math.max(viewport.Y - halfHeight - margin, minY)

        local targetCenter = dragStartCenter + delta
        local x = math.clamp(targetCenter.X, minX, maxX)
        local y = math.clamp(targetCenter.Y, minY, maxY)

        main.Position = UDim2.new(
            0.5, x - viewport.X * 0.5,
            0.5, y - viewport.Y * 0.5
        )
    end
end)

connectGlobal(UserInputService.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input == dragInput then
        dragging = false
        dragInput = nil
    end
end)

