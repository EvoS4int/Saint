    for _, definition in ipairs(definitions) do
        sectionByKey[definition.Key] = definition
        definition.CatalogSet = makeSet(definition.Catalog)
        sectionStates[definition.Key] = {Roots = {}, ByName = {}, Names = {}, RootSummary = "NOT SCANNED"}
    end

    local navigationButtons = {}

    -- Keep internal-only categories available to the scan/automation logic.
    local hiddenNavigationKeys = {
        Workspace = true,
